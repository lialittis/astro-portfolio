---
import { navigation, isCurrentRoute } from '../lib/navigation'
interface Props { variant?: 'legacy' | 'workspace' }
const { variant = 'legacy' } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const links = navigation
const isActive = (href: string) => isCurrentRoute(currentPath, href)
---

<nav class:list={["terminal-nav", { "workspace-nav": variant === "workspace" }]} aria-label="Primary navigation">
  {links.map(({ href, label, path, ...options }) => (
    <a
      href={href}
      class:list={['terminal-nav-link', { active: isActive(href) }]}
      aria-current={isActive(href) ? 'page' : undefined}
      aria-label={('locked' in options && options.locked) ? `${label}, locked` : label}
    >
      {path === '~' ? '~/' : path}{('locked' in options && options.locked) && <span class="lock-mark" aria-hidden="true">◆</span>}
    </a>
  ))}
</nav>

<style>
	.terminal-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex-wrap: wrap;
		min-width: 0;
		margin-left: auto;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.terminal-nav::-webkit-scrollbar {
		display: none;
	}

	.terminal-nav-link {
		flex: 0 0 auto;
		padding: 0.35rem 0.55rem;
		color: var(--muted, #a0b2a4);
		border: 1px solid transparent;
		border-radius: 4px;
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.72rem;
		line-height: 1;
		text-decoration: none;
		transition:
			color 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.terminal-nav-link:hover {
		color: var(--accent, #99d5ab);
		background: var(--surface, #192820);
		border-color: var(--rule, #30443a);
	}

	.terminal-nav-link.active {
		color: var(--accent, #99d5ab);
		background: var(--surface, #192820);
		border-color: var(--rule, #30443a);
		text-shadow: none;
	}

	.lock-mark {
		margin-left: 0.35rem;
		color: #f7c873;
		font-size: 0.55rem;
	}

	:global(body > .terminal-nav),
	:global(body > astro-island > .terminal-nav) {
		width: min(1400px, calc(100% - 2rem));
		box-sizing: border-box;
		margin: 1rem auto 0;
		padding: 0.65rem;
		background: linear-gradient(180deg, #141414 0%, #080808 100%);
		border: 1px solid rgba(0, 255, 65, 0.3);
		border-radius: 8px;
	}

	@media (max-width: 768px) {
		.terminal-nav {
			width: 100%;
			margin-left: 0;
			padding-bottom: 0.15rem;
		}

		.terminal-nav-link {
			padding: 0.4rem 0.5rem;
			font-size: 0.68rem;
		}
	}

	.terminal-nav.workspace-nav {
		width: auto;
		margin: 0;
		padding: 0;
		gap: 2px;
		flex-wrap: nowrap;
		overflow: visible;
	}
	.workspace-nav .terminal-nav-link {
		padding: 7px 8px;
		font: var(--text-meta) / 1.6 var(--mono);
		border-radius: var(--radius-control);
	}
	.workspace-nav .lock-mark {
		color: var(--terminal-warm);
	}
	@media (max-width: 1099px) {
		.terminal-nav.workspace-nav {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			width: 100%;
			gap: 6px;
		}
		.workspace-nav .terminal-nav-link {
			display: flex;
			align-items: center;
			min-height: 40px;
			min-width: 0;
			overflow-wrap: anywhere;
		}
	}
</style>
