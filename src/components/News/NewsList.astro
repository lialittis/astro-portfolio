---
import type { CollectionEntry } from 'astro:content'
import { newsDate, newsTitle, newsUrl, newsPreview } from '../../lib/news'
interface Props { posts: CollectionEntry<'updates'>[] }
const { posts } = Astro.props
---
<ul class="news-list" aria-label="Security news digests">
  {posts.map(post => (
    <li>
      <a class="news-row" href={newsUrl(post)} aria-label={post.data.title}>
        <time datetime={newsDate(post)}>{newsDate(post)}</time>
        <span class="news-copy"><span class="news-title">{newsTitle(post)}</span><span class="news-preview">{newsPreview(post)}</span></span>
        <span class="news-arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>
<style>
  .news-list { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--rule); }
  li:last-child { border-bottom: 1px solid var(--rule); }
  .news-row { display: grid; grid-template-columns: 110px minmax(0, 1fr) 16px; gap: 20px; align-items: baseline; padding: 22px 0; }
  time { color: var(--muted); font: var(--text-meta)/1.6 var(--mono); font-variant-numeric: tabular-nums; }
  .news-title { color: var(--ink); font: 550 var(--text-card)/1.5 var(--font-body); }
  .news-copy { min-width: 0; }
  .news-preview { display: block; margin-top: 6px; color: var(--muted); font: 14px/1.7 var(--font-body); }
  .news-arrow { color: var(--accent); }
  .news-row:hover .news-title { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 600px) {
    .news-row { grid-template-columns: minmax(0, 1fr) 16px; gap: 6px 12px; padding: 18px 0; }
    time { grid-column: 1 / -1; }
  }
</style>
