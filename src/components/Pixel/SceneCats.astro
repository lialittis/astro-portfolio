  .kira-tail { animation: cat-tail 13s steps(1, end) infinite; animation-delay: -3s; }
  .kira-eye { animation: cat-blink 17s steps(1, end) infinite; transform-origin: 8px 8px; animation-delay: -9s; }
  .cat-idle { animation-play-state: paused; }
  :global(.observatory-scene.is-visible) .cat-idle { animation-play-state: running; }
  .scene-cat.is-responding .cat-idle { animation-play-state: paused; }
  @keyframes cat-breathe { 0%, 45%, 100% { transform: translateY(0); } 55%, 75% { transform: translateY(-1px); } }
  @keyframes cat-ear { 0%, 94%, 100% { transform: translateY(0); } 95%, 97% { transform: translateY(-1px); } }
  @keyframes cat-tail { 0%, 76%, 100% { transform: translateY(0); } 80%, 88% { transform: translateY(-1px); } }
  @keyframes cat-blink { 0%, 97%, 100% { transform: scaleY(1); } 98%, 99% { transform: scaleY(0.1); } }
  @media (prefers-reduced-motion: reduce) {
