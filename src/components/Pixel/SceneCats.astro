  :global([data-theme='light'] [data-lamp='auto']) .scene-cat { --fur-warmth: 0%; }
  .mia-light { fill: color-mix(in srgb, var(--mia-coat), #e6bd7c var(--fur-warmth)); }
  .kira-light { fill: color-mix(in srgb, var(--kira-white), #ded9cc var(--fur-warmth)); }
  .mia-light, .kira-light { transition: fill 0.2s; }
