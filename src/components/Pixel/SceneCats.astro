  .kira.is-responding .kira-front,
  .kira.is-responding .tail-curled { display: inline; }
  .mia-head, .kira-head { transition: transform 160ms steps(2, end); }
  .mia.is-responding .mia-head { transform: translateY(-3px); }
  .kira.is-responding .kira-head { transform: translate(-1px, -1px); }
  .mia-body { animation: cat-breathe 7s steps(1, end) infinite; }
