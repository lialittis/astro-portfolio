---
interface Props {
	command: string
}

const { command } = Astro.props
---

<div class="cmd-line">
  <span class="prompt">$</span> <span class="cmd">{command}</span>
</div>

<style>
	.cmd-line {
		font-family: 'SF Mono', 'Monaco', monospace;
		font-size: 14px;
		color: var(--accent, #99d5ab);
		margin-top: 16px;
		margin-bottom: 8px;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.cmd-line .prompt {
		color: var(--accent, #99d5ab);
		font-weight: bold;
	}

	.cmd-line .cmd {
		color: var(--ink, #dce3df);
		animation: typing 0.5s steps(20);
	}

	@keyframes typing {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (max-width: 768px) {
		.cmd-line {
			font-size: 12px;
		}
	}
</style>
