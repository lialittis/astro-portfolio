---
import { shellQuote } from '../lib/terminal'
import { formatDate } from '../lib/helpers'
import type { MarkdownLayoutProps } from 'astro'
import BlogShell from './BlogShell.astro'
import PageHeading from '../components/Pixel/PageHeading.astro'

type Props = MarkdownLayoutProps<{
	title: string
	description: string
	pubDate?: string | Date
	draft?: boolean
	tags?: string[]
	minutesRead: string
}>

const { frontmatter } = Astro.props
const articleFile = `${decodeURIComponent(Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? 'README')}.md`
const pubDate = frontmatter.pubDate ? new Date(frontmatter.pubDate) : undefined
---

<BlogShell
  title={`${frontmatter.title} | Tianchi YU`}
  description={frontmatter.description}
  noindex={frontmatter.draft}
>
  <div class="blog-post">
    <a href="/blog" class="back-link" aria-label="Back to all blog posts">
      ← All writing
    </a>
    {frontmatter.draft && (
      <p class="draft-notice">Draft preview · Visible only during local development.</p>
    )}
    <div class="post-header">
      <PageHeading title={frontmatter.title} command={`cat -- ${shellQuote(articleFile)}`} description={frontmatter.description} />
      <div class="post-meta">
        {pubDate ? <time datetime={pubDate.toISOString()}>
          {formatDate(pubDate)}
        </time> : <span>Unpublished draft</span>}
        <span>{frontmatter.minutesRead}</span>
      </div>
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <ul class="post-tags" aria-label="Tags">
          {frontmatter.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>
    <article class="post-body prose prose-slate prose-invert">
      <slot />
    </article>
  </div>
</BlogShell>

<style>
	.blog-post {
		box-sizing: border-box;
		width: 100%;
		max-width: var(--reading-width);
		min-width: 0;
		margin-inline: auto;
		padding-bottom: 2rem;
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	.back-link {
		display: inline-flex;
		gap: 0.5rem;
		align-items: center;
		color: var(--accent);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.875rem;
		text-decoration: none;
	}

	.back-link span {
		color: var(--accent);
	}

	.back-link:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.back-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.post-header {
		margin-block: 24px 32px;
	}

	.draft-notice {
		margin-top: 2rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--rule);
		border-radius: 0.5rem;
		color: var(--terminal-warm) !important;
		background: var(--surface);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace !important;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-top: 1rem;
		color: var(--muted);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.8rem;
	}

	.post-meta time {
		color: var(--terminal-warm);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.post-tags li {
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--rule);
		border-radius: 0.25rem;
		color: var(--terminal-warm);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.7rem;
		line-height: 1.5;
	}

	.post-body {
		max-width: none;
		font-size: var(--text-body);
		line-height: var(--leading-body);
	}

	.post-body :global(h1, h2, h3, h4, h5, h6) {
		font-family: 'Preview Sans', sans-serif;
		margin-top: 2em;
		margin-bottom: 0.75em;
		line-height: 1.3;
	}

	.post-body :global(h1),
	.post-body :global(h2) {
		font-size: var(--text-section);
	}
	.post-body :global(h3) {
		font-size: var(--text-card);
	}
	.post-body :global(a) {
		color: var(--accent);
		text-decoration-color: var(--rule);
		text-underline-offset: 0.2em;
	}

	.post-body :global(a:hover) {
		color: var(--accent);
	}

	.post-body :global(:not(pre) > code) {
		color: var(--terminal-warm);
		background: var(--surface);
	}

	.post-body :global(code::before),
	.post-body :global(code::after) {
		content: none;
	}

	.post-body :global(pre) {
		box-sizing: border-box;
		max-width: 100%;
		overflow-x: auto;
		padding: 1rem;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.6;
		overflow-wrap: normal;
		white-space: pre;
	}

	.post-body :global(pre code) {
		padding: 0;
		color: inherit;
		background: transparent;
		border-radius: 0;
	}

	.post-body :global(img) {
		max-width: 100%;
		height: auto;
	}

	.post-body :global(table) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
	}
</style>
