---
import PixelLayout from './PixelLayout.astro'
import WindowHeader from '../components/Pixel/WindowHeader.astro'
import TerminalWrapper from '../components/Terminal/TerminalWrapper.astro'
interface Props {
	title: string
	description: string
	path: string
	noindex?: boolean
	article?: boolean
	reading?: boolean
}
const { path, reading = false, ...meta } = Astro.props
---
<PixelLayout {...meta}>
  <div class="interior-shell">
    <TerminalWrapper>
      <WindowHeader />
      <main id="main" class="terminal-content">
        <div class:list={["site-page-content", { "reading-column": reading }]}>
          <slot />
        </div>
      </main>
    </TerminalWrapper>
    <footer class="interior-footer"><a href="/">← Tianchi Yu</a><a href="/#contact">Contact ↗</a></footer>
  </div>
</PixelLayout>
