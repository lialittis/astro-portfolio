---
import PixelLayout from './PixelLayout.astro'
import TerminalHeader from '../components/Terminal/TerminalHeader.astro'
import TerminalWrapper from '../components/Terminal/TerminalWrapper.astro'
interface Props {
	title: string
	description: string
	path: string
	noindex?: boolean
	article?: boolean
}
const { path, ...meta } = Astro.props
---
<PixelLayout {...meta}>
  <div class="interior-shell">
    <TerminalWrapper>
      <TerminalHeader title={path} themeToggle />
      <main id="main" class="terminal-content"><slot /></main>
    </TerminalWrapper>
    <footer class="interior-footer"><a href="/">← Tianchi Yu / personal workspace</a><a href="/#contact">Contact ↗</a></footer>
  </div>
</PixelLayout>
