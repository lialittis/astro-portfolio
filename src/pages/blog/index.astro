---
import { getBlogPosts } from '../../lib/blog'
import BlogShell from '../../layouts/BlogShell.astro'
import PostRow from '../../components/Blog/PostRow.astro'
import PageHeading from '../../components/Pixel/PageHeading.astro'

const posts = await getBlogPosts()
const publishedCount = posts.filter((post) => !post.data.draft).length
const draftCount = posts.length - publishedCount
---

<BlogShell
  title="Tianchi YU - Blog"
  description="Notes on software security, compilers, and programming by Tianchi YU."
>
  <PageHeading title="Writing" command="ls -1" description="Notes on software security, compilers, and programming." />
  <div class="collection-meta">
    <span>
      {publishedCount} published {publishedCount === 1 ? "post" : "posts"}
      {draftCount > 0 && <span class="draft-count"> · {draftCount} local {draftCount === 1 ? "draft" : "drafts"}</span>}
    </span>
    <a href="/rss.xml" class="rss-link">RSS feed <span aria-hidden="true">↗</span></a>
  </div>
  <ul class="post-list" aria-label="Blog posts">
    {
      posts.map((post) => (
        <PostRow
          title={post.data.title}
          description={post.data.description}
          tags={post.data.tags}
          date={post.data.pubDate}
          url={post.slug}
          draft={post.data.draft}
        />
      ))
    }
  </ul>
</BlogShell>

<style>
	.collection-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem 1rem;
		padding-block: 0.75rem;
		border-bottom: 1px solid var(--rule);
		color: var(--muted);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.8rem;
		line-height: 1.6;
	}

	.draft-count {
		color: var(--terminal-warm);
	}

	.rss-link {
		color: var(--accent);
		text-decoration: none;
	}

	.rss-link:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.rss-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
