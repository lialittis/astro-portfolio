---
import ConfTable from '../components/Table/ConfTable'
import Layout from "../layouts/Layout.astro";
import StyleSwitcher from '../components/StyleSwitcher.astro'
import TerminalWrapper from '../components/Terminal/TerminalWrapper.astro'
import TerminalHeader from '../components/Terminal/TerminalHeader.astro'
import CommandLine from '../components/Terminal/CommandLine.astro'

import fs from 'fs'
import path from 'path'
import yaml from 'yaml'
import { deadlineToTimestamp, formatRemainingTime } from '../lib/conferenceTime'

interface TimelineEntry {
	deadline: string
	abstract_deadline?: string
	comment?: string
}

interface ConferenceYear {
	year: number
	id: string
	link: string
	timeline: TimelineEntry[]
	timezone: string
	date: string
	place: string
}

interface Conference {
	title: string
	description: string
	sub: string
	rank: { ccf: string; core: string; thcpl: string }
	dblp: string
	confs: ConferenceYear[]
	latestconf: ConferenceYear
	deadline: string
	deadlineDisplay: string
	deadlineUtc: string
	remainingTime: string
}

const CATEGORY_LABELS = {
	DS: 'Systems',
	SE: 'Software',
	SC: 'Security',
} as const

const loadConferences = (baseDir: string): Conference[] => {
	const conferenceList: Conference[] = []

	// The clock intentionally tracks only CCF-A venues in the requested subjects.
	const categories = fs
		.readdirSync(baseDir, { withFileTypes: true })
		.filter(
			(dirent) =>
				dirent.isDirectory() &&
				dirent.name in CATEGORY_LABELS,
		)
		.map((dirent) => dirent.name)

	categories.forEach((category) => {
		const categoryPath = path.join(baseDir, category)

		// Read all YAML files inside each category
		const files = fs
			.readdirSync(categoryPath)
			.filter((file) => file.endsWith('.yaml') || file.endsWith('.yml'))

		files.forEach((file) => {
			const filePath = path.join(categoryPath, file)
			const content = fs.readFileSync(filePath, 'utf8')

			try {
				const parsed = yaml.parse(content)
				// console.log("Parsed YAML:", parsed);

				// Ensure the parsed data is structured correctly
				if (
					parsed &&
					typeof parsed === 'object' &&
					parsed.confs &&
					parsed.rank?.ccf === 'A'
				) {
					parsed.latestconf = parsed.confs[parsed.confs.length - 1]
					const subject = parsed.sub as keyof typeof CATEGORY_LABELS
					parsed.sub = CATEGORY_LABELS[subject]
					
					const deadlines = parsed.latestconf.timeline
						.map((entry: TimelineEntry) => ({
							entry,
							timestamp: deadlineToTimestamp(
								entry.deadline,
								parsed.latestconf.timezone,
							),
						}))
						.filter(
							(item: { timestamp: number | null }) =>
								item.timestamp !== null,
						)

					if (deadlines.length === 0) {
						console.warn(`Warning: Skipping ${file}; no dated deadline`)
						return
					}

					const now = Date.now()
					const selected =
						deadlines.find(
							(item: { timestamp: number | null }) =>
								item.timestamp! >= now,
						) ?? deadlines[deadlines.length - 1]

					parsed.deadline = selected.entry.deadline
					parsed.deadlineDisplay = `${selected.entry.deadline} ${parsed.latestconf.timezone}`
					parsed.deadlineUtc = new Date(selected.timestamp!).toISOString()
					conferenceList.push(parsed)
				} else {
					console.warn(`Warning: Skipping ${file} due to invalid structure`)
				}
			} catch (error) {
				console.error(`Error parsing YAML file ${filePath}:`, error)
			}
		})
	})

	const now = Date.now()
	return conferenceList.sort((a, b) => {
		const aTime = Date.parse(a.deadlineUtc)
		const bTime = Date.parse(b.deadlineUtc)
		const aActive = aTime >= now
		const bActive = bTime >= now

		if (aActive !== bActive) return aActive ? -1 : 1
		return aActive ? aTime - bTime : bTime - aTime
	})
}

const conferences = loadConferences('./conferences')

// Helper function to calculate remaining time
function calculateRemainingTime(deadlineUtc: string): string {
	return formatRemainingTime(deadlineUtc)
}

const activeConferences = conferences
	.filter((conference) => calculateRemainingTime(conference.deadlineUtc) !== 'EXPIRED')
	.sort((a, b) => Date.parse(a.deadlineUtc) - Date.parse(b.deadlineUtc))
---


<Layout title='Conferences Clock' description=''>
	<StyleSwitcher />
	
	<!-- Modern Layout -->
	<div class='modern-container'>
		<div id='timeDisplay' class='pt-24 md:pt-28 w-full'>
			<header class='clock-intro'>
				<div>
					<p class='clock-eyebrow'>CCF A · {conferences.length} conferences</p>
					<h1>Conference Clock</h1>
					<p>Systems, software & programming languages, and security.</p>
				</div>
				<a href='https://ccfddl.com/' target='_blank' rel='noopener noreferrer'>
					Data from CCFDDL ↗
				</a>
			</header>
			<ConfTable conferences={conferences} client:load />
		</div>
	</div>

	<!-- Hacker Layout -->
    <div id="hacker-container" class="hacker-container hidden">
		<TerminalWrapper>
			<TerminalHeader title='~/conferences/deadlines' />
			<div class='terminal-content'>
				<CommandLine command='cat conferences.info' />
				
				<div class='terminal-output'>
					<div class='info-section'>
						<p class='terminal-text' style='color: #00d9ff; font-weight: 600;'>
							Conference Deadline Tracker - Real-time monitoring system
						</p>
						<p class='terminal-text' style='color: rgba(255, 255, 255, 0.7);'>
							Total conferences: {conferences.length} | CCF rank: A | Categories: Systems, Security, Software
						</p>
					</div>
				</div>

				<CommandLine command='grep -E "ACTIVE|URGENT" ./conferences/* | sort -k2' />
				
				<div class='active-conferences-list'>
					<div class='list-header'>
						<span style='color: #00d9ff; font-weight: 600;'>ACTIVE DEADLINES</span>
						<button id='showTableBtn' class='table-view-btn'>
							<span class='btn-icon'></span> View Full Table
						</button>
					</div>
					
					{activeConferences
						.map(conf => {
							const remaining = calculateRemainingTime(conf.deadlineUtc)
							const isUrgent = parseInt(remaining.split('d')[0]) < 7
							
							return (
								<button
									type='button'
									class={`active-row ${isUrgent ? 'urgent' : ''}`}
									data-conference-trigger={conf.latestconf.id}
									aria-expanded='false'
									aria-controls={`conference-detail-${conf.latestconf.id}`}
								>
									<span class='row-title'>{conf.title}</span>
									<span class='row-category'>{conf.sub}</span>
									<span class='row-rank'>CCF {conf.rank.ccf}</span>
									<span class='row-time' style={isUrgent ? 'color: #ffb86c;' : 'color: #00ff41;'}>
										{remaining}
										<span class='row-arrow' aria-hidden='true'>›</span>
									</span>
								</button>
							)
						})
					}
				</div>

				<CommandLine command='ls -la ./conferences/active/' />
				
				<div class='conference-detail-viewer' aria-live='polite'>
					<div id='conference-detail-empty' class='conference-detail-empty'>
						<span class='empty-cursor'>&gt;_</span>
						<div>
							<p>SELECT AN ACTIVE CONFERENCE</p>
							<span>Click a deadline above to inspect its details.</span>
						</div>
					</div>

					{activeConferences.map(conf => {
						const remaining = calculateRemainingTime(conf.deadlineUtc)
						const isUrgent = parseInt(remaining.split('d')[0]) < 7

						return (
							<article
								id={`conference-detail-${conf.latestconf.id}`}
								class='conf-entry conference-detail-panel hidden'
								data-conference-detail={conf.latestconf.id}
								aria-label={`${conf.title} conference details`}
							>
								<div class='detail-path'>
									<span>$</span> cat ./conferences/active/{conf.latestconf.id}.yml
								</div>
								<div class='conf-header'>
									<span class='conf-number'>[{conf.latestconf.id}]</span>
									<span class='conf-title'>{conf.title}</span>
									<span class={`conf-status ${isUrgent ? 'urgent' : 'active'}`}>
										{isUrgent ? '⚠ URGENT' : '✓ ACTIVE'}
									</span>
								</div>

								<div class='conf-details'>
									<div class='detail-line'>
										<span class='detail-label'>DEADLINE:</span>
										<span class='detail-value' style={isUrgent ? 'color: #ffb86c;' : 'color: #00ff41;'}>
											{conf.deadlineDisplay}
										</span>
										<span class='remaining-time' style={isUrgent ? 'color: #ffb86c;' : 'color: #00ff41;'}>
											({remaining})
										</span>
									</div>
									<div class='detail-line'>
										<span class='detail-label'>DOMAIN:</span>
										<span class='detail-value'>{conf.sub}</span>
									</div>
									<div class='detail-line'>
										<span class='detail-label'>RANK:</span>
										<span class='detail-value'>
											CCF: <span class='rank-badge'>{conf.rank.ccf}</span>
											{conf.rank.core && ` | CORE: `}<span class='rank-badge'>{conf.rank.core}</span>
										</span>
									</div>
									<div class='detail-line'>
										<span class='detail-label'>VENUE:</span>
										<span class='detail-value'>{conf.latestconf.place}</span>
									</div>
									<div class='detail-line'>
										<span class='detail-label'>DATE:</span>
										<span class='detail-value'>{conf.latestconf.date}</span>
									</div>
									{conf.latestconf.link && (
										<div class='detail-line'>
											<span class='detail-label'>LINK:</span>
											<a href={conf.latestconf.link} target='_blank' rel='noopener noreferrer' class='conf-link'>
												{conf.latestconf.link}
											</a>
										</div>
									)}
								</div>

								{conf.description && (
									<div class='conf-description'>
										<p>{conf.description}</p>
									</div>
								)}
							</article>
						)
					})}
				</div>

				<CommandLine command='echo "Monitoring active..."' />
			</div>
		</TerminalWrapper>
	</div>

	<!-- Modal for Table View -->
	<div id='tableModal' class='modal hidden'>
		<div class='modal-content'>
			<div class='modal-header'>
				<h2>Conference Deadlines - Table View</h2>
				<button id='closeModalBtn' class='close-btn'>✕</button>
			</div>
			<div class='modal-body'>
				<ConfTable conferences={conferences} client:load />
			</div>
		</div>
	</div>
</Layout>

<style>
	@import '../style/hacker-theme.css';
	
	/* Container visibility */
	:global(body) {
		height: auto !important;
		min-height: 100vh;
		justify-content: flex-start !important;
		align-items: stretch !important;
	}

	.modern-container {
		display: block;
		position: relative;
		z-index: 100;
		width: 100%;
		max-width: 1500px;
		margin: 0 auto;
		padding: 0 1.5rem 3rem;
		box-sizing: border-box;
	}

	.modern-container.hidden {
		display: none !important;
	}

	.hacker-container {
		display: block;
		min-height: 100vh;
		padding: 0;
		padding-top: 6rem;
		padding-bottom: 2rem;
		z-index: 100;
	}

	.hacker-container.hidden {
		display: none !important;
	}

	.clock-intro {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.5rem 1.75rem;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 18px;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04));
		box-shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
	}

	.clock-intro h1 {
		margin: 0.2rem 0 0.35rem;
		font-size: clamp(2rem, 4vw, 3.4rem);
		line-height: 1;
	}

	.clock-intro p {
		margin: 0;
	}

	.clock-intro .clock-eyebrow {
		color: #a5b4fc !important;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.clock-intro a {
		flex-shrink: 0;
		color: #c4b5fd;
		font-weight: 700;
		text-decoration: none;
	}

	.clock-intro a:hover {
		color: white;
	}

	/* Terminal Output Styles */
	.terminal-output {
		padding: 1rem 0;
	}

	.info-section {
		margin-bottom: 2rem;
		padding: 1rem;
		background: rgba(0, 20, 8, 0.3);
		border: 1px solid rgba(0, 255, 65, 0.2);
		border-radius: 5px;
	}

	.terminal-text {
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.95rem;
		line-height: 1.8;
		margin: 0.5rem 0;
	}

	/* Active Conferences List */
	.active-conferences-list {
		margin: 1.5rem 0;
		background: rgba(0, 20, 8, 0.3);
		border: 1px solid rgba(0, 255, 65, 0.2);
		border-radius: 5px;
		padding: 1rem;
	}

	.list-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid rgba(0, 255, 65, 0.2);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
	}

	.table-view-btn {
		background: rgba(0, 217, 255, 0.1);
		border: 1px solid rgba(0, 217, 255, 0.3);
		color: #00d9ff;
		padding: 0.4rem 1rem;
		border-radius: 5px;
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.85rem;
		cursor: pointer;
		transition: all 0.3s ease;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.table-view-btn:hover {
		background: rgba(0, 217, 255, 0.2);
		border-color: rgba(0, 217, 255, 0.6);
		box-shadow: 0 0 15px rgba(0, 217, 255, 0.3);
		transform: translateY(-1px);
	}

	.btn-icon {
		font-size: 1rem;
	}

	.active-row {
		display: grid;
		grid-template-columns: 2fr 1fr 80px 100px;
		width: 100%;
		gap: 1rem;
		padding: 0.75rem;
		margin: 0.5rem 0;
		background: rgba(0, 40, 10, 0.2);
		border: 1px solid rgba(0, 255, 65, 0.15);
		border-radius: 4px;
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.9rem;
		align-items: center;
		transition: all 0.2s ease;
		appearance: none;
		color: inherit;
		cursor: pointer;
		text-align: left;
	}

	.active-row:hover {
		background: rgba(0, 40, 10, 0.3);
		border-color: rgba(0, 255, 65, 0.3);
		transform: translateX(5px);
	}

	.active-row.urgent {
		border-color: rgba(255, 184, 108, 0.3);
		background: rgba(40, 30, 0, 0.2);
	}

	.active-row.urgent:hover {
		border-color: rgba(255, 184, 108, 0.5);
		background: rgba(40, 30, 0, 0.3);
	}

	.active-row[aria-expanded='true'] {
		background: rgba(0, 65, 20, 0.35);
		border-color: rgba(0, 217, 255, 0.65);
		box-shadow: 0 0 18px rgba(0, 217, 255, 0.12);
	}

	.active-row:focus-visible {
		outline: 2px solid #00d9ff;
		outline-offset: 2px;
	}

	.row-title {
		color: #00ff41;
		font-weight: 600;
	}

	.row-category {
		color: rgba(255, 255, 255, 0.7);
	}

	.row-rank {
		color: #ffb86c;
		font-weight: 600;
		text-align: center;
	}

	.row-time {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.65rem;
		font-weight: 700;
		text-align: right;
	}

	.row-arrow {
		display: inline-block;
		font-size: 1.2rem;
		line-height: 1;
		transition: transform 0.2s ease;
	}

	.active-row[aria-expanded='true'] .row-arrow {
		transform: rotate(90deg);
	}

	/* Modal Styles */
	.modal {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(10px);
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		animation: fadeIn 0.3s ease;
	}

	.modal.hidden {
		display: none !important;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	.modal-content {
		background: rgba(10, 10, 15, 0.95);
		border: 2px solid rgba(0, 255, 65, 0.3);
		border-radius: 12px;
		max-width: 1400px;
		width: 100%;
		max-height: 90vh;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 0 50px rgba(0, 255, 65, 0.2);
		animation: slideUp 0.3s ease;
	}

	@keyframes slideUp {
		from {
			transform: translateY(50px);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	.modal-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem 2rem;
		border-bottom: 1px solid rgba(0, 255, 65, 0.2);
		background: rgba(0, 20, 8, 0.3);
	}

	.modal-header h2 {
		color: #00ff41;
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 1.3rem;
		margin: 0;
	}

	.close-btn {
		background: rgba(255, 85, 85, 0.1);
		border: 1px solid rgba(255, 85, 85, 0.3);
		color: #ff5555;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		font-size: 1.2rem;
		cursor: pointer;
		transition: all 0.3s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.close-btn:hover {
		background: rgba(255, 85, 85, 0.2);
		border-color: rgba(255, 85, 85, 0.6);
		transform: rotate(90deg);
	}

	.modal-body {
		padding: 2rem;
		overflow-y: auto;
		flex: 1;
	}

	/* On-demand conference details */
	.conference-detail-viewer {
		margin: 2rem 0;
	}

	.conference-detail-empty {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 92px;
		padding: 1.25rem 1.5rem;
		border: 1px dashed rgba(0, 217, 255, 0.3);
		border-radius: 8px;
		background: rgba(0, 20, 25, 0.2);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		box-sizing: border-box;
	}

	.conference-detail-empty.hidden {
		display: none !important;
	}

	.conference-detail-empty p {
		margin: 0 0 0.35rem;
		color: #00d9ff;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.conference-detail-empty span:not(.empty-cursor) {
		color: rgba(255, 255, 255, 0.55);
		font-size: 0.82rem;
	}

	.empty-cursor {
		color: #00ff41;
		font-size: 1.4rem;
		font-weight: 700;
		text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
	}

	.conference-detail-panel.hidden {
		display: none !important;
	}

	.conference-detail-panel:not(.hidden) {
		animation: revealDetail 0.22s ease-out;
	}

	@keyframes revealDetail {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.detail-path {
		margin-bottom: 1.25rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid rgba(0, 217, 255, 0.2);
		color: #00d9ff;
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.85rem;
	}

	.detail-path span {
		color: #00ff41;
		font-weight: 700;
	}

	/* Conference Entry */
	.conf-entry {
		background: rgba(0, 20, 8, 0.2);
		border: 1px solid rgba(0, 255, 65, 0.2);
		border-radius: 8px;
		padding: 1.5rem;
		margin-bottom: 1.5rem;
		transition: all 0.3s ease;
	}

	.conf-entry:hover {
		background: rgba(0, 30, 8, 0.3);
		border-color: rgba(0, 255, 65, 0.4);
		box-shadow: 0 0 20px rgba(0, 255, 65, 0.2);
	}

	.conf-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
		flex-wrap: wrap;
	}

	.conf-number {
		color: #00d9ff;
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.conf-title {
		color: #00ff41;
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 1.1rem;
		font-weight: 700;
		flex: 1;
	}

	.conf-status {
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.85rem;
		padding: 0.25rem 0.75rem;
		border-radius: 3px;
		font-weight: 600;
	}

	.conf-status.active {
		color: #00ff41;
		background: rgba(0, 255, 65, 0.1);
		border: 1px solid rgba(0, 255, 65, 0.3);
	}

	.conf-status.urgent {
		color: #ffb86c;
		background: rgba(255, 184, 108, 0.1);
		border: 1px solid rgba(255, 184, 108, 0.3);
	}

	.conf-status.expired {
		color: #ff5555;
		background: rgba(255, 85, 85, 0.1);
		border: 1px solid rgba(255, 85, 85, 0.3);
	}

