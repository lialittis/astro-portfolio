</style>

<script>
	// Toggle between modern and hacker layouts
	function toggleLayout() {
		const modernContainer = document.querySelector('.modern-container')
		const hackerContainer = document.querySelector('.hacker-container')
		const currentStyle = document.body.getAttribute('data-style')

		if (currentStyle === 'hacker') {
			modernContainer?.classList.add('hidden')
			hackerContainer?.classList.remove('hidden')
		} else {
			modernContainer?.classList.remove('hidden')
			hackerContainer?.classList.add('hidden')
		}
	}

	// Initial setup
	toggleLayout()

	// Listen for style changes
	window.addEventListener('styleChange', toggleLayout)
	
	// MutationObserver for reliable theme switching
	const observer = new MutationObserver(() => {
		toggleLayout()
	})

	observer.observe(document.body, {
		attributes: true,
		attributeFilter: ['data-style']
	})

	// Expand one active conference at a time in the terminal detail viewer.
	const conferenceTriggers = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-conference-trigger]')
	)
	const conferenceDetails = Array.from(
		document.querySelectorAll<HTMLElement>('[data-conference-detail]')
	)
	const conferenceDetailEmpty = document.getElementById('conference-detail-empty')

	const collapseConferenceDetails = () => {
		conferenceTriggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'))
		conferenceDetails.forEach((detail) => detail.classList.add('hidden'))
		conferenceDetailEmpty?.classList.remove('hidden')
	}

	conferenceTriggers.forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const wasExpanded = trigger.getAttribute('aria-expanded') === 'true'
			const conferenceId = trigger.dataset.conferenceTrigger
			collapseConferenceDetails()

			if (wasExpanded || !conferenceId) return

			const selectedDetail = conferenceDetails.find(
				(detail) => detail.dataset.conferenceDetail === conferenceId
			)
			if (!selectedDetail) return

			trigger.setAttribute('aria-expanded', 'true')
			conferenceDetailEmpty?.classList.add('hidden')
			selectedDetail.classList.remove('hidden')
			requestAnimationFrame(() => {
				selectedDetail.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
			})
		})
	})

	// Modal functionality
	const showTableBtn = document.getElementById('showTableBtn')
	const closeModalBtn = document.getElementById('closeModalBtn')
	const tableModal = document.getElementById('tableModal')

	showTableBtn?.addEventListener('click', () => {
		tableModal?.classList.remove('hidden')
		document.body.style.overflow = 'hidden'
	})

	closeModalBtn?.addEventListener('click', () => {
		tableModal?.classList.add('hidden')
		document.body.style.overflow = 'auto'
	})

	// Close modal when clicking outside
	tableModal?.addEventListener('click', (e) => {
		if (e.target === tableModal) {
			tableModal.classList.add('hidden')
			document.body.style.overflow = 'auto'
		}
	})

	// Close modal with Escape key
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !tableModal?.classList.contains('hidden')) {
			tableModal?.classList.add('hidden')
			document.body.style.overflow = 'auto'
		} else if (e.key === 'Escape') {
			collapseConferenceDetails()
		}
	})
</script>
