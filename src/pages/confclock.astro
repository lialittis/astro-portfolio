---
import PixelPage from '../layouts/PixelPage.astro'
import PageHeading from '../components/Pixel/PageHeading.astro'
import { workspace } from '../lib/terminal'
import { loadConferences } from '../lib/conferences'
import { formatRemainingTime } from '../lib/conferenceTime'

const conferences = loadConferences()
const isClosed = (deadline: string) => Date.parse(deadline) <= Date.now()
---
<PixelPage title="Conferences | Tianchi Yu" description="Submission deadlines for CCF-A conferences in systems, security, and software." path={workspace.conferences}>
  <PageHeading title="Conferences" command="cat index.tsv" description="CCF A · Systems, Security, Software" />
  <div id="conference-controls" class="conference-controls" hidden>
    <label class="search-field">Search
      <input id="conference-search" type="search" placeholder="Name, topic or location" autocomplete="off" />
    </label>
    <label>Category
      <select id="conference-category"><option value="">All categories</option><option>Systems</option><option>Security</option><option>Software</option></select>
    </label>
    <label>Show
      <select id="conference-status"><option value="upcoming">Upcoming</option><option value="all">All conferences</option></select>
    </label>
    <label>Sort by
      <select id="conference-sort"><option value="deadline">Deadline</option><option value="name">Name</option><option value="category">Category</option></select>
    </label>
  </div>
  <div class="results-bar">
    <p id="conference-count" role="status">{conferences.length} conferences</p>
    <div id="conference-views" class="view-controls" role="group" aria-label="Conference view" hidden>
      <button type="button" class="site-button site-button--small" data-view="list" aria-pressed="true" aria-controls="conference-list">List</button>
      <button type="button" class="site-button site-button--small" data-view="table" aria-pressed="false" aria-controls="conference-table">Table</button>
    </div>
  </div>
  <p id="conference-empty" hidden>No matching conferences. <button type="button" id="conference-reset" class="reset-button">Clear filters</button></p>
  <div id="conference-list">
    {conferences.map(conf => (
      <details class="conference-entry" id={`conference-${conf.latestconf.id}`} data-conference={conf.latestconf.id}>
        <summary>
          <span class="conference-name"><strong>{conf.title} {conf.latestconf.year}</strong><small>{conf.sub}</small></span>
          <span class="deadline-summary"><span data-field="label">{conf.deadlineLabel}</span><time data-field="deadline" datetime={conf.deadlineUtc}>{conf.deadlineDisplay}</time></span>
          <span class="countdown" data-field="remaining">{isClosed(conf.deadlineUtc) ? 'Closed' : formatRemainingTime(conf.deadlineUtc)}</span>
          <span class="expand-arrow" aria-hidden="true">＋</span>
        </summary>
        <div class="conference-detail">
          <p class="conference-description">{conf.description}</p>
          <dl class="conference-meta">
            <div><dt>Conference dates</dt><dd>{conf.latestconf.date}</dd></div>
            <div><dt>Location</dt><dd>{conf.latestconf.place}</dd></div>
            <div><dt>Ranking</dt><dd>CCF {conf.rank.ccf}{conf.rank.core && ` · CORE ${conf.rank.core}`}</dd></div>
          </dl>
          {conf.latestconf.link && <a class="site-button" href={conf.latestconf.link} target="_blank" rel="noopener noreferrer">Conference website <span aria-hidden="true">↗</span></a>}
          <section class="submission-schedule" aria-label={`${conf.title} submission windows`}>
            <h2>Submission windows</h2>
            <ol class="window-list">
              {conf.submissionWindows.map(window => (
                <li data-window={window.id} class:list={["submission-window", { closed: isClosed(window.deadlineUtc) }]}>
                  <div class="window-heading"><h3>{window.label}</h3><span data-window-status>{isClosed(window.deadlineUtc) ? 'Closed' : window.id === conf.submissionWindows.find(w => w.deadlineUtc === conf.deadlineUtc)?.id ? 'Next deadline' : 'Upcoming'}</span></div>
                  <dl>
                    {window.abstractDeadlineUtc && <div><dt>Register / abstract</dt><dd><time data-abstract datetime={window.abstractDeadlineUtc}>{window.abstractDeadlineDisplay}</time><span class="abstract-state" data-abstract-state>{isClosed(window.abstractDeadlineUtc) ? ' · Closed' : ''}</span></dd></div>}
                    <div><dt>Paper</dt><dd><time datetime={window.deadlineUtc}>{window.deadlineDisplay}</time></dd></div>
                  </dl>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </details>
    ))}
  </div>
  <div id="conference-table" hidden>
    <p class="table-hint">Select a conference for all submission windows. Scroll horizontally for more columns.</p>
    <div class="table-scroll" role="region" aria-label="Conference deadlines table" tabindex="0">
      <table>
        <caption class="sr-only">Conference deadlines in the stated source timezone</caption>
        <thead><tr><th scope="col">Conference</th><th scope="col">Category</th><th scope="col">Next / last window</th><th scope="col">Paper deadline</th><th scope="col">Remaining</th><th scope="col">CORE</th><th scope="col">Conference dates</th><th scope="col">Location</th></tr></thead>
        <tbody>{conferences.map(conf => (
          <tr data-table-conference={conf.latestconf.id}>
            <th scope="row"><button type="button" class="inspect-conference" data-inspect={conf.latestconf.id}>{conf.title} {conf.latestconf.year}</button></th>
            <td>{conf.sub}</td><td data-field="label">{conf.deadlineLabel}</td>
            <td><time data-field="deadline" datetime={conf.deadlineUtc}>{conf.deadlineDisplay}</time></td>
            <td class="countdown" data-field="remaining">{isClosed(conf.deadlineUtc) ? 'Closed' : formatRemainingTime(conf.deadlineUtc)}</td>
            <td>{conf.rank.core || '—'}</td><td>{conf.latestconf.date}</td><td>{conf.latestconf.place}</td>
          </tr>
        ))}</tbody>
      </table>
    </div>
  </div>
  <p class="timezone-note">Dates use each conference’s stated timezone. AoE means UTC−12. Countdowns use your device clock.</p>
  <script id="conference-data" type="application/json" set:html={JSON.stringify(conferences.map(({ title, description, sub, latestconf, submissionWindows }) => ({ title, description, sub, id: latestconf.id, place: latestconf.place, submissionWindows }))).replaceAll('<', '\u003c')} />
</PixelPage>

<script src="../scripts/conference-clock.ts"></script>

<style>
  [hidden] { display: none !important; }
  .conference-controls { display: flex; flex-wrap: wrap; align-items: end; gap: 16px; }
  label { display: grid; gap: 8px; color: var(--muted); font: var(--text-meta)/1.6 var(--mono); min-width: 0; }
  .search-field { flex: 1 1 220px; }
  input, select { width: 100%; min-height: 42px; min-width: 0; border: 1px solid var(--rule); border-radius: var(--radius-control); background: var(--terminal-panel); color: var(--ink); padding: 9px 12px; font: 14px/1.5 var(--font-body); }
  input::placeholder { color: var(--muted); }
  input:focus-visible, select:focus-visible, summary:focus-visible, .table-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .results-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  #conference-count, .timezone-note, .table-hint { color: var(--muted); font: var(--text-meta)/1.8 var(--mono); }
  .view-controls { display: flex; gap: 8px; }
  [aria-pressed='true'] { background: var(--surface); border-color: var(--accent); }
  #conference-empty { color: var(--muted); font: var(--text-body)/1.8 var(--font-body); }
  .reset-button { border: 0; background: none; color: var(--accent); text-decoration: underline; padding: 10px 0; }
  .conference-entry { border-top: 1px solid var(--rule); scroll-margin-top: 24px; }
  .conference-entry:last-child { border-bottom: 1px solid var(--rule); }
  summary { display: grid; grid-template-columns: minmax(150px, 1fr) minmax(240px, 1.5fr) 100px 20px; align-items: center; gap: 16px; padding: 24px 0; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary:hover .conference-name strong { color: var(--accent); }
  .conference-name, .deadline-summary { display: grid; gap: 6px; min-width: 0; }
  .conference-name strong { color: var(--ink); font: 600 var(--text-card)/1.4 var(--font-body); }
  .conference-name small, .deadline-summary, .countdown, .expand-arrow { font: var(--text-meta)/1.7 var(--mono); }
  .conference-name small, [data-field='label'] { color: var(--muted); }
  .countdown { color: var(--accent); font-variant-numeric: tabular-nums; }
  [data-urgent='true'] .countdown { color: var(--terminal-warm); }
  [data-closed='true'] .countdown { color: var(--muted); }
  .expand-arrow { color: var(--accent); text-align: right; }
  details[open] > summary .expand-arrow { transform: rotate(45deg); }
  .conference-detail { padding: 0 0 28px; max-width: var(--reading-width); }
  .conference-description { color: var(--muted); font: var(--text-body)/1.8 var(--font-body); }
  dl { margin: 0; }
  dd { margin: 0; }
  .conference-meta { display: grid; gap: 12px; margin: 20px 0; font: 14px/1.8 var(--font-body); }
  dl > div { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 16px; }
  dt { color: var(--muted); }
  .submission-schedule { margin-top: 28px; }
  h2 { font: 600 var(--text-card)/1.4 var(--font-body); }
  .window-list { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 12px; }
  .submission-window { border: 1px solid var(--rule); border-radius: var(--radius-control); padding: 16px; }
  .submission-window.next { border-left: 3px solid var(--accent); }
  .window-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 12px; }
  h3 { font: 600 16px/1.5 var(--font-body); }
  [data-window-status] { color: var(--accent); font: var(--text-meta)/1.6 var(--mono); }
  .closed [data-window-status], .abstract-state { color: var(--muted); }
  .submission-window dl { display: grid; gap: 8px; font: var(--text-meta)/1.8 var(--mono); }
  .table-hint { margin-bottom: 12px; }
  .table-scroll { max-width: 100%; overflow-x: auto; border: 1px solid var(--rule); border-radius: var(--radius-control); }
  table { border-collapse: collapse; width: 100%; min-width: 1050px; font: 13px/1.7 var(--font-body); }
  th, td { text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  thead th { color: var(--muted); background: var(--surface); font-weight: 500; white-space: nowrap; }
  td time { white-space: nowrap; font: var(--text-meta)/1.8 var(--mono); }
  .inspect-conference { background: none; border: 0; padding: 0; color: var(--accent); text-align: left; font: 600 14px/1.8 var(--font-body); text-decoration: underline; text-underline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 800px) {
    summary { grid-template-columns: minmax(0, 1fr) auto 20px; gap: 12px; }
    .deadline-summary { grid-row: 2; grid-column: 1 / -1; }
    .countdown { grid-column: 2; grid-row: 1; }
    .expand-arrow { grid-column: 3; grid-row: 1; }
  }
  @media (max-width: 480px) {
    .conference-controls { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .search-field { grid-column: 1 / -1; }
    dl > div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .submission-window { padding: 12px; }
  }
</style>
