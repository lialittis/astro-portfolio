---
import DesignPreview from '../../layouts/DesignPreview.astro'
import SiteHead from '../../components/design/SiteHead.astro'
import ObservatoryScene from '../../components/design/ObservatoryScene.astro'
import Writing from '../../components/design/Writing.astro'
import Work from '../../components/design/Work.astro'
import Footer from '../../components/design/Footer.astro'
import { getPreviewContent } from '../../lib/design-preview'
const content = await getPreviewContent()
---
<DesignPreview variant="observatory">
  <div class="design-shell observatory-shell">
    <SiteHead variant="observatory" />
    <main id="main">
      <div class="station-label eyebrow"><span>Personal observatory / 001</span><span>Munich <time data-munich-clock aria-label="Current time in Munich">--:--</time></span></div>
      <ObservatoryScene />
      <section class="observatory-intro" aria-labelledby="intro-title"><div class="intro-mark" aria-hidden="true">✳</div><div><div class="eyebrow">Hello, fellow explorer.</div><h1 id="intro-title">Curiosity,<br /><span>made tangible.</span></h1><p>{content.intro}</p><a class="about-link" href="/me">A little more about me ↗</a></div></section>
      <div class="desk-note"><span class="eyebrow"><span class="dot"></span>On the desk</span><p>System security <span>/</span> AI infrastructure <span>/</span> Learning by building</p></div>
      <section class="chapter observatory-writing" id="writing"><div class="section-title"><h2><span>01</span> Signals & notes</h2><a href="/blog">All writing ↗</a></div><Writing posts={content.posts} /></section>
      <section class="chapter observatory-work" id="work"><div class="section-title"><h2><span>02</span> Things taking shape</h2><a href="/project">All projects ↗</a></div><Work projects={content.projects} /></section>
      <section class="observatory-personal" aria-labelledby="personal-title"><div class="eyebrow">03 / Beyond the keyboard</div><h2 id="personal-title">Life outside this window.</h2><p class="body-copy">{content.about}</p><div class="life-path"><span><b>2024.11</b> Began my Ph.D.</span><span class="path-line" aria-hidden="true"></span><span><b>2025.08</b> Got married ♡</span></div><a class="about-link" href="/travel">Places along the way ↗</a></section>
    </main>
    <Footer />
  </div>
</DesignPreview>
<script>
	const clock = document.querySelector<HTMLTimeElement>('[data-munich-clock]')
	if (clock) {
		const formatter = new Intl.DateTimeFormat('en-GB', {
			timeZone: 'Europe/Berlin',
			hour: '2-digit',
			minute: '2-digit',
			hourCycle: 'h23'
		})
		const update = () => {
			const now = new Date()
			clock.textContent = formatter.format(now)
			clock.dateTime = now.toISOString()
		}
		update()
		window.setInterval(() => {
			if (!document.hidden) update()
		}, 30000)
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden) update()
		})
	}
</script>
<style>
	.observatory-shell {
		max-width: 920px;
	}
	.station-label {
		display: flex;
		justify-content: space-between;
		margin: 12px 0;
		font-size: 9px;
		letter-spacing: 0.12em;
	}
	.station-label time {
		color: var(--accent);
		margin-left: 8px;
	}
	.observatory-intro {
		display: grid;
		grid-template-columns: 50px 1fr;
		gap: 24px;
		margin: 42px 0 30px;
	}
	.intro-mark {
		height: 44px;
		width: 44px;
		display: grid;
		place-items: center;
		border: 1px solid var(--rule);
		font-size: 35px;
		color: var(--accent);
		margin-top: 4px;
	}
	.observatory-intro h1 {
		font:
			550 clamp(44px, 6vw, 66px) / 1.05 'Preview Display',
			sans-serif;
		letter-spacing: -2px;
		margin: 14px 0 22px;
	}
	.observatory-intro h1 span {
		color: var(--accent);
	}
	.observatory-intro p {
		font-size: 16px;
		line-height: 1.8;
		color: var(--muted);
		max-width: 560px;
	}
	.about-link {
		display: inline-block;
		font: 12px var(--mono);
		color: var(--accent);
		margin-top: 20px;
	}
	.about-link:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.desk-note {
		border: 1px dashed var(--rule);
		background: var(--surface);
		padding: 18px 22px;
	}
	.desk-note p {
		font: 11px/1.8 var(--mono);
		color: var(--muted);
		margin-top: 8px;
	}
	.desk-note p span {
		margin: 0 8px;
		color: var(--accent);
	}
	.observatory-writing,
	.observatory-work {
		margin-top: 48px;
	}
	.section-title h2 {
		font:
			500 22px 'Preview Display',
			sans-serif;
	}
	.section-title h2 > span {
		font: 10px var(--mono);
		color: var(--accent);
		margin-right: 12px;
	}
	.observatory-writing :global(.writing-link) {
		grid-template-columns: 90px 1fr 20px;
	}
	.observatory-writing :global(.writing-link h3) {
		font-size: 17px;
	}
	.observatory-work :global(.work-visual) {
		background-image:
			linear-gradient(var(--rule) 1px, transparent 1px),
			linear-gradient(90deg, var(--rule) 1px, transparent 1px);
		background-size: 20px 20px;
	}
	.observatory-work :global(.work-visual svg) {
		background: var(--surface);
		padding: 8px;
	}
	.observatory-work :global(.work-visual > span) {
		background: var(--surface);
		padding: 3px 5px;
	}
	.observatory-personal {
		padding-top: 28px;
		border-top: 1px dashed var(--rule);
		margin-top: 45px;
	}
	.observatory-personal h2 {
		font:
			500 29px 'Preview Display',
			sans-serif;
		margin: 14px 0;
	}
	.life-path {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-top: 22px;
		font: 11px/1.8 var(--mono);
		color: var(--muted);
	}
	.life-path b {
		display: block;
		font-weight: 400;
		color: var(--accent);
	}
	.path-line {
		height: 1px;
		border-top: 1px dashed var(--rule);
		width: 60px;
	}
	@media (max-width: 600px) {
		.observatory-intro {
			grid-template-columns: 1fr;
			margin-top: 28px;
			gap: 16px;
		}
		.intro-mark {
			display: none;
		}
		.observatory-intro h1 {
			font-size: 51px;
		}
		.station-label {
			font-size: 8px;
		}
		.observatory-writing :global(.writing-link) {
			grid-template-columns: 1fr 20px;
		}
		.desk-note {
			padding: 16px;
		}
		.desk-note p span {
			margin: 0 3px;
		}
		.section-title h2 {
			font-size: 21px;
		}
		.section-title > a {
			font-size: 10px;
		}
		.section-title h2 > span {
			margin-right: 7px;
		}
		.life-path {
			gap: 12px;
		}
		.path-line {
			width: 25px;
		}
		.observatory-personal h2 {
			font-size: 26px;
		}
	}
</style>
