---
import DesignPreview from '../../layouts/DesignPreview.astro'
import SiteHead from '../../components/design/SiteHead.astro'
import Writing from '../../components/design/Writing.astro'
import Work from '../../components/design/Work.astro'
import Footer from '../../components/design/Footer.astro'
import { getPreviewContent } from '../../lib/design-preview'
const content = await getPreviewContent()
---
<DesignPreview variant="paper">
  <div class="design-shell paper-shell">
    <SiteHead />
    <main id="main">
      <section class="paper-hero" aria-labelledby="intro-title">
        <div class="hero-meta eyebrow"><span>Personal space / Tianchi Yu</span><span>Munich, DE · 48° N</span></div>
        <div class="hero-grid">
          <div><h1 id="intro-title">Curiosity,<br /><span>made tangible.</span></h1><p class="intro">{content.intro}</p><a class="text-link" href="/me">A little more about me <span>↗</span></a></div>
          <div class="orbital" aria-hidden="true">
            <svg viewBox="0 0 250 260" fill="none">
              <g stroke="currentColor" stroke-width=".8"><circle cx="125" cy="122" r="88"/><circle cx="125" cy="122" r="61" stroke-dasharray="2 5"/><ellipse cx="125" cy="122" rx="39" ry="88" transform="rotate(35 125 122)"/><ellipse cx="125" cy="122" rx="39" ry="88" transform="rotate(-35 125 122)"/><path d="M125 15V229M18 122H232" stroke-dasharray="2 5"/><path d="M25 25H40M25 25V40M225 25H210M225 25V40M25 219H40M25 219V204M225 219H210M225 219V204"/></g>
              <circle cx="125" cy="122" r="7" fill="currentColor"/><circle cx="196" cy="70" r="5" fill="var(--paper)" stroke="currentColor"/><text x="125" y="252" text-anchor="middle" fill="currentColor" font-size="8" font-family="monospace" letter-spacing="2">ALWAYS A WORK IN PROGRESS</text>
            </svg>
          </div>
        </div>
        <div class="focus-line"><span class="eyebrow"><span class="dot"></span>On the desk</span><span>System security</span><span>AI infrastructure</span><span>Learning by building<span class="cursor" aria-hidden="true">_</span></span></div>
      </section>
      <section class="chapter paper-writing" id="writing">
        <div class="section-title"><h2><span class="section-no">01 /</span> Notes & writing</h2><a href="/blog">All writing ↗</a></div>
        <Writing posts={content.posts} />
      </section>
      <section class="chapter paper-work" id="work">
        <div class="section-title"><h2><span class="section-no">02 /</span> Selected work</h2><a href="/project">All projects ↗</a></div>
        <Work projects={content.projects} />
      </section>
      <section class="paper-personal" aria-labelledby="beyond-title">
        <div><span class="eyebrow">03 / Beyond the keyboard</span><h2 id="beyond-title">A person, too.</h2></div>
        <div><p class="body-copy">{content.about}</p><div class="life-notes"><span>2025.08 — Got married ♡</span><span>2024.11 — Began my Ph.D.</span></div><a class="text-link" href="/travel">Places along the way ↗</a></div>
      </section>
    </main>
    <Footer />
  </div>
</DesignPreview>
<style>
	.paper-shell {
		border-left: 1px solid var(--rule);
		border-right: 1px solid var(--rule);
	}
	.paper-hero {
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.hero-meta {
		display: flex;
		justify-content: space-between;
		padding-top: 22px;
		font-size: 10px;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 260px;
		gap: 32px;
		align-items: center;
		padding: 52px 0 45px;
	}
	h1 {
		font-family: 'Preview Display', sans-serif;
		font-size: clamp(54px, 7vw, 84px);
		font-weight: 550;
		line-height: 1.02;
		letter-spacing: -3.5px;
	}
	h1 span {
		color: var(--accent);
	}
	.intro {
		max-width: 470px;
		font-size: 17px;
		line-height: 1.8;
		margin: 27px 0 24px;
		color: var(--muted);
	}
	.text-link {
		display: inline-block;
		font: 12px/1.8 var(--mono);
		border-bottom: 1px solid var(--accent);
		padding-bottom: 4px;
	}
	.text-link span {
		margin-left: 18px;
	}
	.orbital {
		color: var(--accent);
		padding-top: 15px;
	}
	.focus-line {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		border-top: 1px dashed var(--rule);
		padding: 18px 0;
		font: 11px/1.6 var(--mono);
		color: var(--muted);
	}
	.focus-line > span + span::before {
		content: '/';
		margin-right: 20px;
		color: var(--rule);
	}
	.cursor {
		animation: blink 1.4s step-end infinite;
		color: var(--accent);
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.paper-writing,
	.paper-work {
		margin-top: 58px;
	}
	.section-no {
		font: 11px var(--mono);
		color: var(--accent);
		vertical-align: middle;
		margin-right: 14px;
	}
	.paper-personal {
		margin-top: 60px;
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 45px;
		padding: 30px 0 0;
		border-top: 1px solid var(--rule);
	}
	.paper-personal h2 {
		font-family: 'Preview Display', sans-serif;
		font-size: 30px;
		font-weight: 500;
		margin-top: 12px;
	}
	.life-notes {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		font: 11px/1.8 var(--mono);
		color: var(--muted);
		margin: 18px 0;
	}
	@media (max-width: 800px) {
		.hero-grid {
			grid-template-columns: 1fr 190px;
			gap: 15px;
		}
		.focus-line {
			gap: 12px;
		}
		.focus-line > span + span::before {
			margin-right: 10px;
		}
	}
	@media (max-width: 600px) {
		.paper-shell {
			border: none;
		}
		.hero-grid {
			grid-template-columns: 1fr;
			padding: 35px 0;
		}
		.orbital {
			display: none;
		}
		.hero-meta {
			font-size: 9px;
		}
		.hero-meta > span:last-child {
			display: none;
		}
		h1 {
			font-size: 60px;
			letter-spacing: -2.5px;
		}
		.intro {
			font-size: 16px;
		}
		.focus-line {
			gap: 8px 14px;
		}
		.focus-line .eyebrow {
			width: 100%;
		}
		.focus-line > span + span::before {
			display: none;
		}
		.paper-writing,
		.paper-work {
			margin-top: 40px;
		}
		.paper-personal {
			grid-template-columns: 1fr;
			gap: 16px;
			margin-top: 42px;
		}
		.section-no {
			margin-right: 6px;
		}
	}
</style>
