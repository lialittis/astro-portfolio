---
import DesignPreview from '../../layouts/DesignPreview.astro'
import ObservatoryScene from '../../components/design/ObservatoryScene.astro'
import TerminalPrompt from '../../components/design/TerminalPrompt.astro'
import Writing from '../../components/design/Writing.astro'
import Work from '../../components/design/Work.astro'
import { getPreviewContent } from '../../lib/design-preview'
const content = await getPreviewContent()
const sections = [
  { id: 'intro', label: 'home', file: 'README.md', number: '01' },
  { id: 'writing', label: 'writing', file: 'writing/', number: '02' },
  { id: 'work', label: 'projects', file: 'projects/', number: '03' },
  { id: 'life', label: 'life', file: 'life.log', number: '04' },
]
---
<DesignPreview variant="pixel-terminal">
  <div class="pixel-desktop">
    <div class="desktop-label"><a href="/design/pixel-terminal/">TY<span class="pixel-spark" aria-hidden="true">✳</span><span>personal workspace</span></a><span class="desktop-location">Munich, DE <span class="separator">/</span> <time data-pixel-clock aria-label="Current time in Munich">--:--</time></span></div>
    <div class="pixel-window">
      <header class="window-chrome">
        <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        <span class="window-title">tianchi@home <span>—</span> ~/personal-space</span>
        <button class="theme-button" data-theme-toggle aria-label="Switch color theme">☀</button>
      </header>
      <nav class="window-tabs" aria-label="Workspace sections">
        {sections.map((section, i) => <a href={`#${section.id}`} data-section-link={section.id} aria-current={i === 0 ? 'location' : undefined}><span aria-hidden="true">{section.number}</span> {section.label}<span class="tab-extension" aria-hidden="true">{i === 0 ? '.md' : i === 3 ? '.log' : '/'}</span></a>)}
      </nav>
      <div class="workspace-grid">
        <aside class="workspace-sidebar" aria-label="Workspace directory">
          <div class="sidebar-sticky">
            <div class="sidebar-label">EXPLORER</div>
            <div class="directory-root"><span aria-hidden="true">⌄</span> ~/tianchi</div>
            <nav aria-label="File navigation">
              {sections.map((section, i) => <a href={`#${section.id}`} data-section-link={section.id} aria-current={i === 0 ? 'location' : undefined}><span aria-hidden="true">{i === 0 ? '≡' : i === 3 ? '·' : '▸'}</span>{section.file}</a>)}
            </nav>
            <div class="sidebar-label elsewhere-label">ELSEWHERE</div>
            <nav aria-label="More about Tianchi"><a href="/publications"><span aria-hidden="true">↗</span> Research</a><a href="/travel"><span aria-hidden="true">↗</span> Travels</a><a href={content.github}><span aria-hidden="true">↗</span> GitHub</a><a href="/me"><span aria-hidden="true">↗</span> About me</a></nav>
            <div class="sidebar-note"><span aria-hidden="true">✳</span><p>A little structure.<br />Room to explore.</p></div>
          </div>
        </aside>
        <main id="main" class="workspace-main">
          <section id="intro" class="chapter intro-chapter" aria-labelledby="intro-title">
            <div class="scene-heading"><span><span aria-hidden="true">▧</span> workspace.scene</span><span>an open window</span></div>
            <ObservatoryScene />
            <div class="intro-content">
              <TerminalPrompt command="whoami" />
              <div class="identity"><h1 id="intro-title">Tianchi Yu<span class="block-cursor" aria-hidden="true"></span></h1><span class="chinese-name" lang="zh-CN">于天池</span></div>
              <p class="intro-tagline">Curiosity, <span>made tangible.</span></p>
              <p class="intro-bio">{content.intro}</p>
              <div class="focus-tags"><span>system security</span><span>AI infrastructure</span><span>learning by building</span></div>
              <a class="inline-link" href="/me">Read more about me <span aria-hidden="true">↗</span></a>
            </div>
          </section>
          <section id="writing" class="chapter output-section" aria-labelledby="writing-title">
            <TerminalPrompt command="ls ./writing" />
            <div class="section-title"><h2 id="writing-title">Notes from the notebook</h2><a href="/blog">All writing ↗</a></div>
            <Writing posts={content.posts} />
            <p class="output-count">{String(content.posts.length).padStart(2, '0')} selected entries <span aria-hidden="true">·</span> thoughts, experiments & things learned</p>
          </section>
          <section id="work" class="chapter output-section" aria-labelledby="work-title">
            <TerminalPrompt command="ls ./projects" />
            <div class="section-title"><h2 id="work-title">Things taking shape</h2><a href="/project">All projects ↗</a></div>
            <Work projects={content.projects} />
          </section>
          <section id="life" class="chapter output-section life-section" aria-labelledby="life-title">
            <TerminalPrompt command="cat life.log" />
            <div class="section-title"><h2 id="life-title">Beyond the keyboard</h2><a href="/travel">Explore places ↗</a></div>
            <p class="body-copy">{content.about}</p>
            <ol class="life-log"><li><time datetime="2025-08">2025.08</time><span>Got married <span class="warm-heart" aria-hidden="true">♡</span></span></li><li><time datetime="2024-11">2024.11</time><span>Began my Ph.D. journey</span></li></ol>
          </section>
          <footer class="workspace-contact">
            <TerminalPrompt command="say hello" />
            <p>Good conversations start with a small message.</p>
            <nav aria-label="Contact and feeds"><a href="/#contact">Email ↗</a><a href={content.github}>GitHub ↗</a><a href="/rss.xml">RSS ↗</a></nav>
          </footer>
        </main>
      </div>
      <footer class="window-status"><span><span class="status-square" aria-hidden="true"></span> personal space</span><a href="#intro">↑ Back to top</a><span class="status-note">built with curiosity</span></footer>
    </div>
    <div class="desktop-footer"><span>© {new Date().getFullYear()} Tianchi Yu</span><span>A person behind the prompt.</span></div>
  </div>
</DesignPreview>
<script>
	const clock = document.querySelector<HTMLTimeElement>('[data-pixel-clock]')
	if (clock) {
		const formatter = new Intl.DateTimeFormat('en-GB', {
			timeZone: 'Europe/Berlin',
			hour: '2-digit',
			minute: '2-digit',
			hourCycle: 'h23'
		})
		const update = () => {
			const now = new Date()
			clock.textContent = formatter.format(now)
			clock.dateTime = now.toISOString()
		}
		update()
		window.setInterval(() => {
			if (!document.hidden) update()
		}, 30000)
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden) update()
		})
	}

	// Track the reading position. These are ordinary anchors, including without JS.
	const chapters = [
		...document.querySelectorAll<HTMLElement>('.workspace-main > section[id]')
	]
	const links = document.querySelectorAll<HTMLAnchorElement>(
		'[data-section-link]'
	)
	let scheduled = false
	function updateSection() {
		const offset =
			(document.querySelector('.preview-toolbar')?.getBoundingClientRect()
				.height ?? 0) + 80
		let active = chapters[0]?.id
		for (const chapter of chapters)
			if (chapter.getBoundingClientRect().top <= offset) active = chapter.id
		if (
			window.scrollY + window.innerHeight >=
			document.documentElement.scrollHeight - 2
		)
			active = chapters.at(-1)?.id
		links.forEach((link) => {
			if (link.dataset.sectionLink === active)
				link.setAttribute('aria-current', 'location')
			else link.removeAttribute('aria-current')
		})
		scheduled = false
	}
	window.addEventListener(
		'scroll',
		() => {
			if (!scheduled) {
				scheduled = true
				requestAnimationFrame(updateSection)
			}
		},
		{ passive: true }
	)
	window.addEventListener('resize', updateSection)
	window.addEventListener('pageshow', updateSection)
	updateSection()
</script>
<style>
	.pixel-desktop {
		max-width: 1180px;
		margin: 0 auto;
		padding: 30px 32px 24px;
	}
	.desktop-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin: 4px 0 22px;
		font: 11px/1.6 var(--mono);
	}
	.desktop-label > a {
		display: flex;
		align-items: center;
		gap: 13px;
		font-weight: 600;
	}
	.desktop-label > a > span:last-child {
		color: var(--muted);
		font-weight: 400;
	}
	.pixel-spark {
		font-size: 25px;
		color: var(--accent);
	}
	.desktop-location {
		color: var(--muted);
	}
	.desktop-location time {
		color: var(--terminal-warm);
	}
	.separator {
		margin: 0 12px;
		color: var(--rule);
	}
	.pixel-window {
		border: 1px solid var(--rule);
		border-radius: 9px;
		background: var(--terminal-panel);
		box-shadow: 0 20px 65px #00000020;
	}
	.window-chrome {
		display: flex;
		align-items: center;
		gap: 20px;
		background: var(--terminal-chrome);
		border-radius: 8px 8px 0 0;
		border-bottom: 1px solid var(--rule);
		padding: 12px 18px;
	}
	.window-dots {
		display: flex;
		gap: 7px;
	}
	.window-dots i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #c88477;
	}
	.window-dots i:nth-child(2) {
		background: #c7ad70;
	}
	.window-dots i:nth-child(3) {
		background: #7baf8d;
	}
	.window-title {
		font: 11px/1.6 var(--mono);
		color: var(--accent);
		flex: 1;
		overflow-wrap: anywhere;
	}
	.window-title > span {
		color: var(--muted);
		margin: 0 7px;
	}
	.window-chrome .theme-button {
		width: 30px;
		height: 30px;
		border-radius: 4px;
		font-size: 20px;
		flex-shrink: 0;
	}
	.window-tabs {
		display: flex;
		padding-left: 174px;
		border-bottom: 1px solid var(--rule);
		background: var(--terminal-chrome);
	}
	.window-tabs a {
		padding: 14px 21px;
		color: var(--muted);
		font: 11px var(--mono);
		border-right: 1px solid var(--rule);
		border-bottom: 2px solid transparent;
	}
	.window-tabs a:first-child {
		border-left: 1px solid var(--rule);
	}
	.window-tabs a > span:first-child {
		font-size: 9px;
		margin-right: 9px;
		opacity: 0.8;
	}
	.window-tabs a[aria-current] {
		color: var(--accent);
		background: var(--terminal-panel);
		border-bottom-color: var(--accent);
	}
	.window-tabs a:hover {
		background: var(--surface);
		color: var(--accent);
	}
	.workspace-grid {
		display: grid;
		grid-template-columns: 174px minmax(0, 1fr);
	}
	.workspace-sidebar {
		border-right: 1px solid var(--rule);
		background: var(--terminal-chrome);
		padding: 25px 14px;
	}
	.sidebar-sticky {
		position: sticky;
		top: 80px;
	}
	.sidebar-label {
		font: 9px var(--mono);
		letter-spacing: 0.14em;
		color: var(--muted);
		margin: 0 10px 22px;
	}
	.directory-root {
		font: 11px var(--mono);
		color: var(--accent);
		margin: 0 10px 12px;
	}
	.directory-root > span {
		margin-right: 6px;
	}
	.workspace-sidebar nav {
		display: grid;
		gap: 3px;
	}
	.workspace-sidebar nav a {
		display: flex;
		gap: 10px;
		align-items: center;
		padding: 10px 8px;
		font: 11px var(--mono);
		color: var(--muted);
		border-left: 2px solid transparent;
	}
	.workspace-sidebar nav a > span {
		color: var(--accent);
	}
	.workspace-sidebar nav a[aria-current] {
		background: var(--surface);
		color: var(--ink);
		border-color: var(--accent);
	}
	.workspace-sidebar nav a:hover {
		color: var(--accent);
		background: var(--surface);
	}
	.elsewhere-label {
		margin-top: 40px;
		margin-bottom: 12px;
	}
	.sidebar-note {
		margin: 42px 10px 0;
		border-top: 1px dashed var(--rule);
		padding-top: 22px;
		color: var(--muted);
	}
	.sidebar-note > span {
		color: var(--terminal-warm);
		font-size: 25px;
	}
	.sidebar-note p {
		font: 10px/1.9 var(--mono);
		margin-top: 12px;
	}
	.workspace-main {
		min-width: 0;
		padding: 26px 32px 32px;
	}
	.scene-heading {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		font: 10px/1.7 var(--mono);
		color: var(--muted);
		margin-bottom: 10px;
	}
	.scene-heading > span:first-child {
		color: var(--accent);
	}
	.scene-heading > span > span {
		color: var(--terminal-warm);
		margin-right: 6px;
	}
	.intro-content {
		padding: 30px 0 0;
	}
	.identity {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 17px;
		margin: 16px 0 12px;
	}
	h1 {
		font:
			600 clamp(36px, 4.5vw, 54px) / 1.1 'Preview Display',
			sans-serif;
		letter-spacing: -1.5px;
	}
	.chinese-name {
		font-size: 14px;
		color: var(--muted);
	}
	.block-cursor {
		display: inline-block;
		width: 0.2em;
		height: 0.65em;
		margin-left: 12px;
		background: var(--accent);
		animation: cursor-blink 1.8s step-end 3;
	}
	@keyframes cursor-blink {
		50% {
			opacity: 0;
		}
	}
	.intro-tagline {
		font-size: 23px;
		letter-spacing: -0.5px;
	}
	.intro-tagline > span {
		color: var(--terminal-warm);
	}
	.intro-bio {
		font-size: 16px;
		line-height: 1.85;
		color: var(--muted);
		max-width: 610px;
		margin-top: 16px;
	}
	.focus-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 20px 0;
	}
	.focus-tags span {
		padding: 5px 9px;
		border: 1px solid var(--rule);
		background: var(--surface);
		font: 10px/1.6 var(--mono);
		color: var(--accent);
	}
	.inline-link {
		font: 11px/1.8 var(--mono);
		color: var(--accent);
	}
	.inline-link > span {
		margin-left: 12px;
	}
	.inline-link:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}
	.output-section {
		border-top: 1px dashed var(--rule);
		margin-top: 38px;
		padding-top: 24px;
	}
	.section-title {
		margin: 15px 0 20px;
	}
	.section-title h2 {
		font:
			500 25px/1.3 'Preview Display',
			sans-serif;
	}
	.section-title > a {
		font-size: 10px;
	}
	.output-section :global(.writing-link) {
		grid-template-columns: 76px 1fr 16px;
		gap: 15px;
		padding: 22px 0;
	}
	.output-section :global(.writing-link h3) {
		font-size: 17px;
		font-weight: 550;
	}
	.output-section :global(.writing-link p) {
		font-size: 13px;
	}
	.output-count {
		font: 9px/1.8 var(--mono);
		color: var(--muted);
		margin-top: 14px;
	}
	.output-count > span {
		margin: 0 6px;
	}
	.output-section :global(.selected-work) {
		gap: 22px;
	}
	.output-section :global(.work-visual) {
		background: var(--surface);
		height: 140px;
	}
	.output-section :global(.work-visual svg) {
		color: var(--accent);
	}
	.output-section :global(.work-item h3) {
		font-size: 18px;
	}
	.output-section :global(.work-visual > span) {
		font-size: 8px;
	}
	.output-section :global(.work-item .eyebrow) {
		font-size: 9px;
	}
	.life-log {
		list-style: none;
		margin: 22px 0 0;
		padding: 0;
		border-left: 1px solid var(--rule);
	}
	.life-log li {
		display: flex;
		gap: 25px;
		position: relative;
		align-items: baseline;
		margin-left: 18px;
		padding: 10px 0;
		font-size: 14px;
	}
	.life-log li::before {
		content: '';
		position: absolute;
		width: 5px;
		height: 5px;
		background: var(--accent);
		left: -21px;
		top: 17px;
	}
	.life-log time {
		font: 10px var(--mono);
		color: var(--muted);
	}
	.warm-heart {
		color: var(--terminal-warm);
		margin-left: 8px;
	}
	.workspace-contact {
		border-top: 1px dashed var(--rule);
		padding-top: 22px;
		margin-top: 35px;
	}
	.workspace-contact p {
		color: var(--muted);
		font-size: 14px;
		line-height: 1.8;
		margin: 12px 0;
	}
	.workspace-contact nav {
		display: flex;
		gap: 25px;
		font: 11px/1.8 var(--mono);
		color: var(--accent);
	}
	.window-status {
		display: flex;
		justify-content: space-between;
		gap: 15px;
		padding: 12px 18px;
		border-top: 1px solid var(--rule);
		border-radius: 0 0 8px 8px;
		background: var(--terminal-chrome);
		font: 10px/1.5 var(--mono);
		color: var(--muted);
	}
	.status-square {
		display: inline-block;
		width: 6px;
		height: 6px;
		background: var(--accent);
		margin-right: 8px;
	}
	.window-status a {
		color: var(--accent);
	}
	.desktop-footer {
		display: flex;
		justify-content: space-between;
		gap: 15px;
		font: 10px/1.6 var(--mono);
		color: var(--muted);
		margin: 20px 2px 0;
	}
	@media (min-width: 1000px) {
		.pixel-desktop {
			background-image: radial-gradient(var(--rule) 0.5px, transparent 0.5px);
			background-size: 9px 9px;
		}
		.desktop-label,
		.desktop-footer {
			background: var(--paper);
			padding: 4px 0;
		}
	}
	@media (max-width: 900px) {
		.pixel-desktop {
			padding: 20px;
		}
		.workspace-sidebar {
			display: none;
		}
		.workspace-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.window-tabs {
			padding-left: 0;
		}
		.window-tabs a:first-child {
			border-left: 0;
		}
		.workspace-main {
			padding: 24px;
		}
		.sidebar-sticky {
			position: static;
		}
	}
	@media (max-width: 600px) {
		.pixel-desktop {
			padding: 16px 12px;
		}
		.desktop-label {
			font-size: 10px;
			margin-bottom: 14px;
			gap: 10px;
		}
		.desktop-label > a > span:last-child {
			display: none;
		}
		.separator {
			margin: 0 6px;
		}
		.window-chrome {
			padding: 10px 12px;
			gap: 12px;
		}
		.window-dots {
			gap: 4px;
		}
		.window-dots i {
			width: 7px;
			height: 7px;
		}
		.window-title {
			font-size: 10px;
		}
		.window-title > span {
			margin: 0 2px;
		}
		.window-tabs {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.window-tabs a {
			padding: 13px 4px;
			text-align: center;
			font-size: 10px;
		}
		.window-tabs a > span:first-child {
			display: none;
		}
		.window-tabs a:last-child {
			border-right: 0;
		}
		.workspace-main {
			padding: 17px 15px 24px;
		}
		.scene-heading {
			font-size: 9px;
		}
		.scene-heading > span:last-child {
			display: none;
		}
		.intro-content {
			padding-top: 24px;
		}
		.identity {
			gap: 12px;
		}
		h1 {
			font-size: 40px;
		}
		.chinese-name {
			font-size: 12px;
		}
		.intro-tagline {
			font-size: 21px;
		}
		.intro-bio {
			font-size: 15px;
		}
		.focus-tags {
			gap: 6px;
		}
		.focus-tags span {
			font-size: 9px;
			padding: 4px 7px;
		}
		.section-title {
			flex-wrap: wrap;
			gap: 10px;
		}
		.section-title h2 {
			font-size: 24px;
		}
		.output-section {
			margin-top: 30px;
			padding-top: 22px;
		}
		.output-section :global(.writing-link) {
			grid-template-columns: 1fr 16px;
			gap: 8px;
		}
		.output-section :global(.selected-work) {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.life-log li {
			gap: 15px;
			font-size: 13px;
		}
		.window-status {
			padding: 12px;
			font-size: 9px;
			gap: 10px;
		}
		.status-note {
			display: none;
		}
		.desktop-footer {
			font-size: 9px;
			flex-wrap: wrap;
		}
		.output-count {
			font-size: 9px;
		}
		.life-section .body-copy {
			font-size: 15px;
		}
	}
</style>
