	<!-- Hacker Mode Layout -->
	<div class="hacker-container">
		<TerminalWrapper>
			<TerminalHeader title="root@tianchi:~$" />
			
			<div class="terminal-content">
				<CommandLine command="whoami" />
				<div class="hacker-intro">
					<IntroCard />
				</div>

				<CommandLine command="cat skills.txt" />
				<div class="hacker-section">
					<KeyWords />
				</div>

				<CommandLine command="ls -la ./content" />
				<div class="hacker-grid">
					<Card
						colSpan='md:col-span-1'
						rowSpan='md:row-span-1'
						title='Blog'
						href='/blog'
					>
						<p>More Coming...</p>
					</Card>
					<SecurityNewsCard />
				</div>

				<CommandLine command="./show_map.sh" />
				<div class="hacker-section">
					<Card
						colSpan='md:col-span-1'
						rowSpan='md:row-span-1'
						title='Countries I visited'
						href='travel'
					>
						<div class='h-[250px] w-full relative flex items-center justify-center'>
							<Globe client:load />
						</div>
					</Card>
				</div>

				<CommandLine command="cat contact.json" />
				<div class="hacker-grid">
					<ContactsCard />
					<Now />
					<TimeZone />
				</div>
			</div>
		</TerminalWrapper>
	</div>
</Layout>

<style>
  @import "../style/hacker-theme.css";

  /* Hacker Container */
  .hacker-container {
    display: block;
    min-height: 100vh;
    padding: 2rem;
    padding-top: 6rem; /* Space for navbar */
  }

  @media (max-width: 768px) {
    .hacker-container {
      padding: 1rem;
      padding-top: 5rem;
    }
  }
</style>
