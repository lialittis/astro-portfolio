---
import { workspace } from '../lib/terminal'
import PixelPage from '../layouts/PixelPage.astro'
import TerminalPrompt from '../components/Pixel/TerminalPrompt.astro'
import ProgressVault from '../components/ProgressVault'
---
<PixelPage title="Progress | Tianchi Yu" description="Encrypted personal progress board." path={workspace.home} noindex>
  <TerminalPrompt command={`sudo -u root -- ls ${workspace.progress}`} />
  <div class="progress-vault-root">
    <ProgressVault client:load />
    <noscript><p class="noscript-message">Enable JavaScript to unlock this page. Decryption happens in your browser.</p></noscript>
  </div>
</PixelPage>
<style>
  .progress-vault-root { min-width: 0; }
  .noscript-message { margin-top: 20px; color: var(--terminal-warm); font: var(--text-body)/1.8 var(--font-body); }
</style>
