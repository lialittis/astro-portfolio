---
import { workspace, projectFolder } from '../lib/terminal'
import PixelPage from '../layouts/PixelPage.astro'
import PageHeading from '../components/Pixel/PageHeading.astro'
import projects from '../lib/Projects'

const directoryEntries = [...projects].sort((a, b) =>
  projectFolder(a).localeCompare(projectFolder(b), 'en')
)
const isRepository = (url: string) =>
  ['github.com', 'gitea.com'].includes(new URL(url).hostname)
---

<PixelPage title="Projects | Tianchi Yu" description="Projects and experiments by Tianchi Yu." path={workspace.projects}>
  <PageHeading title="Projects" command="ls -1F" />

  <ul class="project-list" aria-label="Projects">
    {directoryEntries.map(project => {
      const folder = projectFolder(project)
      const technologies = project.technologies.filter(technology => technology.trim())
      const studiesUrl = project.slug && project.studies?.length ? `/project/${project.slug}/` : undefined
      return (
        <li>
          <article class="project-entry" aria-labelledby={`project-${folder}`}>
            <header class="project-entry-header">
              <div class="project-identity">
                <p class="project-directory">{folder}/</p>
                <h2 id={`project-${folder}`}>{project.title}</h2>
              </div>
              <div class="project-meta">
                {project.status === 'preparing' && <span class="project-status">Preparing</span>}
                {project.updatedAt && <time datetime={project.updatedAt}>Updated {project.updatedAt}</time>}
              </div>
            </header>

            {project.description && <p class="project-description">{project.description}</p>}

            {technologies.length > 0 && (
              <ul class="project-technologies" aria-label="Technologies">
                {technologies.map(technology => <li>{technology}</li>)}
              </ul>
            )}

            {(studiesUrl || project.url) && (
              <div class="project-actions">
                {studiesUrl && <a href={studiesUrl} class="site-button">View {project.studies!.length} studies <span aria-hidden="true">→</span></a>}
                {project.url && <a href={project.url} class="project-external-link" target="_blank" rel="noopener noreferrer">
                  {isRepository(project.url) ? 'Source repository' : 'Project website'} <span aria-hidden="true">↗</span>
                </a>}
              </div>
            )}
          </article>
        </li>
      )
    })}
  </ul>
</PixelPage>

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-list > li {
    border-top: 1px solid var(--rule);
  }
  .project-list > li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .project-entry {
    display: grid;
    gap: 16px;
    padding: 28px 0;
    min-width: 0;
  }
  .project-entry-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .project-identity {
    flex: 1 1 320px;
    min-width: 0;
  }
  .project-directory {
    color: var(--accent);
    font: var(--text-meta)/1.6 var(--mono);
    overflow-wrap: anywhere;
    margin-bottom: 8px;
  }
  h2 {
    color: var(--ink);
    font: 600 var(--text-section)/1.35 var(--font-body);
  }
  .project-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    color: var(--muted);
    font: var(--text-meta)/1.6 var(--mono);
    font-variant-numeric: tabular-nums;
  }
  .project-meta:empty {
    display: none;
  }
  .project-status {
    color: var(--terminal-warm);
    border: 1px solid var(--rule);
    border-radius: var(--radius-control);
    padding: 3px 8px;
  }
  .project-description {
    color: var(--muted);
    max-width: var(--reading-width);
    font: var(--text-body)/var(--leading-body) var(--font-body);
  }
  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project-technologies li {
    padding: 3px 8px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-control);
    color: var(--muted);
    font: var(--text-meta)/1.6 var(--mono);
  }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
  }
  .project-external-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    color: var(--accent);
    font: var(--text-meta)/1.6 var(--mono);
    text-underline-offset: 4px;
  }
  .project-external-link:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .project-entry { padding: 24px 0; }
    .project-identity { flex-basis: 100%; }
  }
</style>
