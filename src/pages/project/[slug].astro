---
import { projectFolder } from '../../lib/terminal'
import projects, { getStudySourceUrl, type Project } from '../../lib/Projects'
import { readReportLock } from '../../lib/project-reports.mjs'
import ProjectDetailLayout from '../../layouts/ProjectDetailLayout.astro'
import PageHeading from '../../components/Pixel/PageHeading.astro'

export function getStaticPaths() {
	return projects
		.filter((project) => project.slug && project.studies?.length)
		.map((project) => ({
			params: { slug: project.slug },
			props: { project }
		}))
}

interface Props {
	project: Project
}
const { project } = Astro.props
const lock = await readReportLock()
---

<ProjectDetailLayout folder={projectFolder(project)} title={`${project.title} | Tianchi YU`} description={project.description}>
  <a class="back-link" href="/project">← All projects</a>
  <div class="project-hero">
    <PageHeading title={project.title} command="ls -1" description={project.description} />
    <ul class="technology-list" aria-label="Technologies">
      {project.technologies.map(technology => <li>{technology}</li>)}
    </ul>
    <a class="source-link" href={project.url}>View repository <span aria-hidden="true">↗</span></a>
  </div>

  <section class="studies-section" aria-labelledby="studies-heading">
    <div class="section-heading">
      <h2 id="studies-heading">Selected studies</h2>
      <span>{project.studies?.length} studies</span>
    </div>
    <p class="section-intro">Focused experiments, reproducible examples, and visual explanations.</p>
    <div class="study-grid">
      {project.studies?.map((study) => {
        const record = lock.reports[`${project.slug}/${study.slug}`];
        return (
          <article class:list={['study-card', { 'has-report': !!study.report }]}>
            <div class="study-label">
              <span class="study-number">{study.slug}/</span>
              <span>{study.report ? 'VISUAL REPORT' : 'EXPERIMENT'}</span>
            </div>
            <h3>{study.title}</h3>
            <p>{study.description}</p>
            <ul class="technology-list" aria-label="Study technologies">
              {study.technologies.map(technology => <li>{technology}</li>)}
            </ul>
            {record && <time class="study-date" datetime={record.updatedAt}>Report updated {record.updatedAt}</time>}
            <div class="study-actions">
              {study.report && <a class="site-button" href={`/project/${project.slug}/${study.slug}/`}>Read visual report <span aria-hidden="true">→</span></a>}
              <a class="source-link" href={getStudySourceUrl(project, study, record?.commit)}>{study.report ? 'Experiment code' : 'Code & notes'} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</ProjectDetailLayout>

<style>
	.back-link,
	.source-link,
	a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.project-hero {
		max-width: var(--reading-width);
		display: grid;
		gap: 20px;
		padding-bottom: 1.5rem;
	}

	.technology-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}

	.technology-list li {
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--rule);
		border-radius: 0.25rem;
		color: var(--terminal-warm);
		background: var(--surface);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.studies-section {
		border-top: 1px solid var(--rule);
		padding-top: 1.5rem;
	}

	.section-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.section-heading h2 {
		margin: 0;
		color: var(--ink);
		font-family: var(--font-body);
		font-size: var(--text-section);
		font-weight: 500;
	}

	.section-heading > span,
	.study-date {
		color: var(--muted);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.75rem;
	}

	.section-intro {
		margin: 0.75rem 0 1.5rem;
		color: var(--muted) !important;
		line-height: 1.7;
	}

	.study-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.study-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
		padding: 1.5rem;
		border: 1px solid var(--rule);
		border-top: 2px solid var(--rule);
		border-radius: 0.5rem;
		background: var(--surface);
	}

	.study-card.has-report {
		border-top-color: var(--accent);
	}

	.study-label {
		display: flex;
		align-items: center;
		gap: 1rem;
		color: var(--muted);
		font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}

	.study-number {
		color: var(--accent);
		font-size: 1rem;
	}

	.study-card h3 {
		margin: 0;
		color: var(--ink);
		font-family: var(--font-body);
		font-size: var(--text-card);
		font-weight: 600;
		line-height: 1.5;
	}

	.study-card p {
		margin: 0;
		color: var(--muted) !important;
		line-height: 1.8;
	}

	.study-card .technology-list {
		margin: 0;
	}

	.study-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: auto;
		padding-top: 0.75rem;
	}

	@media (max-width: 768px) {
		.study-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.study-card {
			padding: 1rem;
		}
	}
</style>
