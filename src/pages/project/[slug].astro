---
import projects, { getStudySourceUrl, type Project } from "../../lib/Projects";
import { readReportLock } from "../../lib/project-reports.mjs";
import ProjectDetailLayout from "../../layouts/ProjectDetailLayout.astro";
import CommandLine from "../../components/Terminal/CommandLine.astro";

export function getStaticPaths() {
  return projects.filter(project => project.slug && project.studies?.length).map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props { project: Project }
const { project } = Astro.props;
const lock = await readReportLock();
---

<ProjectDetailLayout title={`${project.title} | Tianchi YU`} description={project.description}>
  <a class="back-link" href="/project">← All projects</a>
  <CommandLine command={`ls -lt ./${project.slug}`} />
  <header class="project-hero">
    <h1>{project.title}</h1>
    <p>{project.description}</p>
    <ul class="technology-list" aria-label="Technologies">
      {project.technologies.map(technology => <li>{technology}</li>)}
    </ul>
    <a class="source-link" href={project.url}>View repository <span aria-hidden="true">↗</span></a>
  </header>

  <section class="studies-section" aria-labelledby="studies-heading">
    <div class="section-heading">
      <h2 id="studies-heading">Selected studies</h2>
      <span>{project.studies?.length} studies</span>
    </div>
    <p class="section-intro">Focused experiments, reproducible examples, and visual explanations.</p>
    <div class="study-grid">
      {project.studies?.map((study, index) => {
        const record = lock.reports[`${project.slug}/${study.slug}`];
        return (
          <article class:list={['study-card', { 'has-report': !!study.report }]}>
            <div class="study-label">
              <span class="study-number">{String(index + 1).padStart(2, '0')}</span>
              <span>{study.report ? 'VISUAL REPORT' : 'EXPERIMENT'}</span>
            </div>
            <h3>{study.title}</h3>
            <p>{study.description}</p>
            <ul class="technology-list" aria-label="Study technologies">
              {study.technologies.map(technology => <li>{technology}</li>)}
            </ul>
            {record && <time class="study-date" datetime={record.updatedAt}>Report updated {record.updatedAt}</time>}
            <div class="study-actions">
              {study.report && <a class="report-link" href={`/project/${project.slug}/${study.slug}/`}>Read visual report <span aria-hidden="true">→</span></a>}
              <a class="source-link" href={getStudySourceUrl(project, study, record?.commit)}>{study.report ? 'Experiment code' : 'Code & notes'} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</ProjectDetailLayout>

<style>
  .back-link, .source-link, .report-link {
    color: #00d9ff;
    font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
    font-size: 0.875rem;
    text-decoration: none;
    line-height: 1.6;
  }

  a:hover {
    color: #00ff41;
    text-decoration: underline;
  }

  a:focus-visible {
    outline: 2px solid #00d9ff;
    outline-offset: 4px;
  }

  .project-hero {
    max-width: 56rem;
    padding-bottom: 1.5rem;
  }

  .project-hero h1 {
    margin: 0;
    color: #00d9ff !important;
    font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 600;
    line-height: 1.25;
    text-wrap: balance;
  }

  .project-hero p {
    margin: 1.25rem 0;
    color: #b8c4c0 !important;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .technology-list li {
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(247, 200, 115, 0.2);
    border-radius: 0.25rem;
    color: #f7c873;
    background: rgba(247, 200, 115, 0.04);
    font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .studies-section {
    border-top: 1px solid rgba(0, 255, 65, 0.2);
    padding-top: 1.5rem;
  }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .section-heading h2 {
    margin: 0;
    color: #00ff41 !important;
    font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .section-heading > span, .study-date {
    color: #789184;
    font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
    font-size: 0.75rem;
  }

  .section-intro {
    margin: 0.75rem 0 1.5rem;
    color: #a7b5ae !important;
    line-height: 1.7;
  }

  .study-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .study-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid rgba(0, 255, 65, 0.2);
    border-top: 2px solid rgba(0, 255, 65, 0.5);
    border-radius: 0.5rem;
    background: linear-gradient(135deg, rgba(0, 22, 18, 0.65), rgba(0, 8, 6, 0.9));
  }

  .study-card.has-report {
    border-top-color: #00d9ff;
  }

  .study-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: #789184;
    font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .study-number {
    color: #00ff41;
    font-size: 1rem;
  }

  .study-card h3 {
    margin: 0;
    color: #00d9ff !important;
    font-family: 'SF Mono', 'Monaco', 'Courier New', monospace;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .study-card p {
    margin: 0;
    color: #a7b5ae !important;
    line-height: 1.8;
  }

  .study-card .technology-list {
    margin: 0;
  }

  .study-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .report-link {
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(0, 217, 255, 0.4);
    border-radius: 0.25rem;
    background: rgba(0, 217, 255, 0.06);
  }

  @media (max-width: 768px) {
    .study-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .study-card {
      padding: 1rem;
    }
  }
</style>
