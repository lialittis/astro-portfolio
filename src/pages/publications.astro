---
import { workspace } from '../lib/terminal'
import { publications, researchDirections } from '../lib/research'
import PixelPage from '../layouts/PixelPage.astro'
import PageHeading from '../components/Pixel/PageHeading.astro'
---

<PixelPage title="Research | Tianchi Yu" description="Publications, current research directions, and collaboration interests of Tianchi Yu." path={workspace.research}>
  <PageHeading title="Research" command="ls -1F" />

  <section class="publications-section" aria-labelledby="publications-heading">
    <h2 id="publications-heading" class="section-heading">Publications</h2>
    <ul class="publication-list">
      {publications.map(pub => (
        <li>
          <article class="publication-entry" aria-labelledby={`publication-${pub.slug}`}>
            <header class="publication-header">
              <p class="publication-file">{pub.slug}.md</p>
              <time datetime={String(pub.year)}>{pub.year}</time>
              <h3 id={`publication-${pub.slug}`}>{pub.title}</h3>
            </header>
            <p class="publication-authors">
              {pub.authors.map((author, index) => <>{index > 0 && ', '}{author === 'Tianchi Yu' ? <strong>{author}</strong> : author}</>)}
            </p>
            <p class="publication-venue"><span>{pub.venue}</span> · {pub.conference}</p>
            <div class="publication-links">
              <a class="site-button" href={pub.url} target="_blank" rel="noopener noreferrer">Publication <span aria-hidden="true">↗</span></a>
              <a class="text-link" href={pub.pdf} target="_blank" rel="noopener noreferrer">PDF <span aria-hidden="true">↗</span></a>
            </div>
            <details class="publication-abstract">
              <summary>Abstract</summary>
              <p>{pub.abstract}</p>
            </details>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <section class="current-directions" aria-labelledby="directions-heading">
    <p class="directory-label">in_progress/</p>
    <h2 id="directions-heading" class="section-heading">Current directions</h2>
    <ul class="direction-list">
      {researchDirections.map(direction => (
        <li>
          <h3>{direction.title}</h3>
          <p>{direction.description}</p>
          {direction.href && <a class="text-link" href={direction.href}>Related experiments <span aria-hidden="true">→</span></a>}
        </li>
      ))}
    </ul>
    <div class="collaboration-note">
      <p>If you’re working on related questions, I’d be happy to exchange ideas, compare experiments, or discuss a possible collaboration.</p>
      <a href="/#contact" class="site-button">Get in touch <span aria-hidden="true">→</span></a>
    </div>
  </section>
</PixelPage>

<style>
  .section-heading {
    color: var(--ink);
    font: 600 var(--text-section)/1.35 var(--font-body);
  }
  .publication-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }
  .publication-list > li { border-top: 1px solid var(--rule); }
  .publication-entry { display: grid; gap: 14px; padding: 24px 0; }
  .publication-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 16px; align-items: baseline; }
  .publication-file, .directory-label {
    color: var(--accent);
    font: var(--text-meta)/1.6 var(--mono);
    overflow-wrap: anywhere;
  }
  .publication-header time { color: var(--muted); font: var(--text-meta)/1.6 var(--mono); font-variant-numeric: tabular-nums; }
  .publication-header h3 { grid-column: 1 / -1; color: var(--ink); font: 600 var(--text-section)/1.4 var(--font-body); }
  .publication-authors, .publication-venue { color: var(--muted); font: var(--text-body)/var(--leading-body) var(--font-body); max-width: var(--reading-width); }
  .publication-authors strong { color: var(--ink); font-weight: 600; }
  .publication-venue span { color: var(--ink); }
  .publication-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; }
  .text-link { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; color: var(--accent); font: var(--text-meta)/1.6 var(--mono); text-underline-offset: 4px; }
  .text-link:hover { text-decoration: underline; }
  .publication-abstract { max-width: var(--reading-width); }
  summary { width: fit-content; padding: 8px 0; color: var(--accent); font: var(--text-meta)/1.6 var(--mono); cursor: pointer; }
  summary:hover { text-decoration: underline; text-underline-offset: 4px; }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .publication-abstract p { padding-top: 12px; color: var(--muted); font: var(--text-body)/var(--leading-body) var(--font-body); }
  .current-directions { border-top: 1px solid var(--rule); padding-top: 28px; }
  .directory-label { margin-bottom: 8px; }
  .direction-list { list-style: none; padding: 0; margin: 24px 0; display: grid; gap: 20px; max-width: var(--reading-width); }
  .direction-list h3 { color: var(--ink); font: 550 var(--text-card)/1.4 var(--font-body); }
  .direction-list p { margin-top: 6px; color: var(--muted); font: var(--text-body)/var(--leading-body) var(--font-body); }
  .direction-list .text-link { margin-top: 4px; }
  .collaboration-note { border-left: 2px solid var(--rule); padding-left: 18px; max-width: var(--reading-width); }
  .collaboration-note p { color: var(--muted); font: var(--text-body)/var(--leading-body) var(--font-body); margin-bottom: 16px; }
  @media(max-width:600px) { .publication-header { grid-template-columns: minmax(0, 1fr); gap: 8px; } .publication-header time { grid-row: 3; } }
</style>
