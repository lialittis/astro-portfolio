---
import PixelPage from '../layouts/PixelPage.astro'
import PageHeading from '../components/Pixel/PageHeading.astro'
import NewsList from '../components/News/NewsList.astro'
import { getSecurityNews } from '../lib/news'
import { workspace } from '../lib/terminal'

const posts = await getSecurityNews()
const latestPosts = posts.slice(0, 3)
---
<PixelPage title="Security News | Tianchi Yu" description="Security news digests, collected by date with links to the original sources." path={workspace.news}>
  <PageHeading title="Security News" command="ls -1r *.md | head -n 3" />
  <NewsList posts={latestPosts} />
  {posts.length === 0 && <p>No security news yet.</p>}
  {posts.length > 3 && <div><a class="site-button" href="/security-news/archive/">All digests <span aria-hidden="true">→</span></a></div>}
</PixelPage>
