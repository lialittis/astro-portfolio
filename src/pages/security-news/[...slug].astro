---
import type { CollectionEntry } from 'astro:content'
import PixelPage from '../../layouts/PixelPage.astro'
import PageHeading from '../../components/Pixel/PageHeading.astro'
import { getSecurityNews, newsDate, newsUrl, newsTitle } from '../../lib/news'
import { workspace, shellQuote } from '../../lib/terminal'

export async function getStaticPaths() {
  const posts = await getSecurityNews()
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[index - 1], older: posts[index + 1] }
  }))
}
interface Props {
  post: CollectionEntry<'updates'>
  newer?: CollectionEntry<'updates'>
  older?: CollectionEntry<'updates'>
}
const { post, newer, older } = Astro.props
const { Content } = await post.render()
---
<PixelPage title={`${post.data.title} | Tianchi Yu`} description={`Security news digest for ${newsDate(post)}, with links to the original sources.`} path={workspace.news} reading article>
  <div><a class="back-link" href="/security-news/archive/">← All digests</a></div>
  <header class="digest-heading">
    <PageHeading title={newsTitle(post)} command={`cat -- ${shellQuote(`${post.slug}.md`)}`} />
    <time datetime={newsDate(post)}>{newsDate(post)}</time>
  </header>
  <article class="news-body" aria-label={post.data.title}>
    <Content />
  </article>
  <nav class="digest-navigation" aria-label="Adjacent news digests">
    {newer && <a class="site-button" href={newsUrl(newer)}>← Newer · {newsDate(newer)}</a>}
    {older && <a class="site-button" href={newsUrl(older)}>Older · {newsDate(older)} →</a>}
  </nav>
  <div><a class="back-link" href="#main">↑ Back to top</a></div>
</PixelPage>
<style>
  .digest-heading time { display: block; margin-top: 16px; color: var(--muted); font: var(--text-meta)/1.6 var(--mono); font-variant-numeric: tabular-nums; }
  .back-link { display: inline-flex; align-items: center; min-height: 40px; color: var(--accent); font: var(--text-meta)/1.6 var(--mono); text-underline-offset: 4px; }
  .back-link:hover { text-decoration: underline; }
  .news-body { min-width: 0; color: var(--ink); font: var(--text-body)/var(--leading-body) var(--font-body); overflow-wrap: anywhere; }
  .news-body :global(p) { margin-block: 16px; }
  .news-body :global(h2) { border-top: 1px solid var(--rule); margin-top: 40px; padding-top: 24px; font: 600 var(--text-section)/1.4 var(--font-body); }
  .news-body :global(h3) { margin-top: 28px; font: 600 var(--text-card)/1.5 var(--font-body); }
  .news-body :global(h4) { margin-top: 24px; font-weight: 600; }
  .news-body :global(> :first-child) { margin-top: 0; }
  .news-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .news-body :global(a:hover) { color: var(--ink); }
  .news-body :global(em) { color: var(--muted); }
  .news-body :global(img) { max-width: 100%; height: auto; }
  .news-body :global(pre) { max-width: 100%; overflow-x: auto; padding: 16px; background: var(--surface); }
  .news-body :global(blockquote) { border-left: 2px solid var(--rule); padding-left: 18px; margin-inline: 0; }
  .digest-navigation { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; border-top: 1px solid var(--rule); padding-top: 24px; }
</style>
