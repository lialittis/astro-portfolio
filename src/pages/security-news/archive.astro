---
import PixelPage from '../../layouts/PixelPage.astro'
import PageHeading from '../../components/Pixel/PageHeading.astro'
import NewsList from '../../components/News/NewsList.astro'
import { getSecurityNews } from '../../lib/news'
import { workspace } from '../../lib/terminal'

const posts = await getSecurityNews()
const years = [...new Set(posts.map(post => post.data.date.getUTCFullYear()))]
---
<PixelPage title="Security News Archive | Tianchi Yu" description="All security news digests, sorted from newest to oldest." path={workspace.news}>
  <PageHeading title="News archive" command="ls -1r *.md" />
  <div class="archive-tools">
    <a class="site-button" href="/security-news/">← Latest digests</a>
    <nav aria-label="Archive years">
      {years.map(year => <a href={`#year-${year}`}>{year}</a>)}
    </nav>
  </div>
  {years.map(year => (
    <section class="archive-year" id={`year-${year}`} aria-labelledby={`heading-${year}`}>
      <h2 id={`heading-${year}`}>{year}</h2>
      <NewsList posts={posts.filter(post => post.data.date.getUTCFullYear() === year)} />
    </section>
  ))}
  {posts.length === 0 && <p>No security news yet.</p>}
</PixelPage>
<style>
  .archive-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  nav { display: flex; flex-wrap: wrap; gap: 20px; }
  nav a { display: inline-flex; align-items: center; min-height: 40px; color: var(--accent); font: var(--text-meta)/1.6 var(--mono); text-underline-offset: 4px; }
  nav a:hover { text-decoration: underline; }
  .archive-year { scroll-margin-top: 24px; }
  h2 { margin: 8px 0 18px; color: var(--ink); font: 600 var(--text-section)/1.4 var(--font-body); }
</style>
